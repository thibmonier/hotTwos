# US-009 (T-009-01) / ADR-15 — analyse statique au niveau maximal.
# Bloquant en CI (US-004). Extensions Symfony + Doctrine incluses.
includes:
    - vendor/phpstan/phpstan-symfony/extension.neon
    - vendor/phpstan/phpstan-symfony/rules.neon
    - vendor/phpstan/phpstan-doctrine/extension.neon
    - vendor/phpstan/phpstan-doctrine/rules.neon

parameters:
    level: max
    paths:
        - src
        - tests
    excludePaths:
        # Bootstrap généré par le framework (test-pack) — non pertinent pour l'analyse.
        - tests/bootstrap.php
    ignoreErrors:
        # Hook optionnel du MicroKernelTrait, appelé dynamiquement par le framework.
        - identifier: method.unused
          message: '#Method App\\Kernel::getAllowedEnvs\(\) is unused#'
          path: src/Kernel.php
    symfony:
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml
