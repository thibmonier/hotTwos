# Amorce ADR-2 — configuration FrankenPHP/Caddy en mode worker.
# Finalisée et exercée via docker-compose en US-007 (parité dev/prod, ARC-86).
{
	frankenphp {
		# Charge l'application une fois et la garde en mémoire entre les requêtes.
		# L'état inter-requêtes doit être remis à zéro à chaque requête (ARC-47/61) —
		# vérifié par les tests en mode worker de la CI (US-004, ARC-50).
		worker ./public/index.php
	}
}

:8080 {
	root * public/
	encode zstd br gzip
	php_server
}
