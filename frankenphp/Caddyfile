# FrankenPHP/Caddy — configuration de service (ADR-2).
{
	frankenphp
	# Désactive HTTP/2 cleartext (h2c) : certains proxies (Railway, OrbStack) l'utilisent
	# et FrankenPHP corrompt alors la méthode HTTP. On n'accepte que h1 et h2 (sur TLS).
	servers {
		protocols h1 h2
	}
	# Mode worker (ADR-2) : à activer une fois le bridge runtime résolu (T-006-02).
	# frankenphp { worker ./public/index.php }
}

{$SERVER_NAME:-:8080} {
	root * public/
	encode zstd br gzip
	php_server
}
