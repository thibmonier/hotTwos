#!/usr/bin/env sh
# US-009 (T-009-05) / ADR-16 — garde-fou pré-commit.
# Active-le une fois : git config core.hooksPath .githooks
# Rejoue en local les vérifications bloquantes de la CI (US-004).
#
# ARC-86 : TOUT s'exécute dans un conteneur (parité prod) — aucune commande sur l'hôte.
# Seul Docker est requis sur le poste.
set -e

echo "▶ Analyse conteneurisée (PHPStan max · Deptrac)…"
docker compose run --rm -T app sh -lc '\
  php vendor/bin/phpstan analyse --no-progress --memory-limit=1G && \
  php vendor/bin/deptrac analyse --no-progress'

# US-095/S23 T-TECH-01 (rétro S22 ACTION-3) : miroir de la CI, qui bloque sur php-cs-fixer.
echo "▶ Style de code (php-cs-fixer, dry-run)…"
docker compose run --rm -T -e PHP_CS_FIXER_IGNORE_ENV=1 app php vendor/bin/php-cs-fixer fix --dry-run

echo "▶ Tests conteneurisés…"
docker compose run --rm -T -e APP_ENV=test app sh -lc 'php bin/console cache:clear --env=test --no-warmup >/dev/null && php bin/phpunit -c phpunit.dist.xml'

echo "▶ gitleaks (secrets, staged)…"
docker run --rm -v "$(pwd):/repo:ro" zricethezav/gitleaks:v8.18.4 protect --staged --source=/repo --no-banner

echo "✅ pre-commit OK"
