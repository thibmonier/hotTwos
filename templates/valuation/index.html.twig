{% extends 'base.html.twig' %}

{% block title %}Valorisation du temps validé{% endblock %}

{% block page_section %}Finance &amp; rentabilité{% endblock %}
{% block page_title %}Valorisation du temps validé{% endblock %}

{% block body %}
    {# H1 lecteur d'écran, attendu par les tests (sous-chaîne "tableau de bord financier"). #}
    <h1 class="sr-only">tableau de bord financier</h1>

    <twig:tsf:Layout:PageHeader
        title="Valorisation du temps validé"
        subtitle="CA reconnu, occupation et marge du temps validé" />

    {# ── Alerte valorisation incomplète ─────────────────────────────────────── #}
    {% if summary.hasIncompleteValuations %}
        <div class="mb-6 flex items-start gap-3 rounded-2xl border border-warning-200 bg-warning-50 px-4 py-3 text-theme-sm text-warning-700 dark:border-warning-500/30 dark:bg-warning-500/10 dark:text-warning-400" role="alert">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="mt-0.5 shrink-0"><path d="M12 9v4M12 17h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/></svg>
            <div>
                <strong>Valorisation incomplète</strong> —
                {{ summary.missingRate }} imputation{{ summary.missingRate > 1 ? 's' : '' }} sans tarif.
                Renseignez le tarif du profil concerné pour compléter le calcul (relance automatique).
            </div>
        </div>
    {% endif %}

    {# ── KPI row (G1 — tsf:Ui:StatCard) ─────────────────────────────────────── #}
    <h2 class="mb-3 text-theme-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">Indicateurs clés</h2>

    {# Grille 4 colonnes ; sans accès coût : CA(1 col) + Avancement(3 cols). #}
    <div class="mb-6 grid grid-cols-1 gap-4 sm:grid-cols-4">
        <twig:tsf:Ui:StatCard
            label="CA reconnu"
            value="{{ (summary.revenueCents / 100)|number_format(2, ',', ' ') }} €"
            variant="brand" />

        <div class="{{ canViewCost ? '' : 'sm:col-span-3' }}">
            <twig:tsf:Ui:StatCard
                label="Avancement valorisation"
                value="{{ summary.valued }} / {{ summary.total }}"
                :progress="summary.total ? (summary.valued / summary.total * 100)|round : 0"
                hint="imputations valorisées" />
        </div>

        {% if canViewCost %}
            <twig:tsf:Ui:StatCard
                label="Coût chargé"
                value="{{ (summary.costCents / 100)|number_format(2, ',', ' ') }} €" />

            <twig:tsf:Ui:StatCard
                label="Marge brute"
                value="{{ (summary.marginCents / 100)|number_format(2, ',', ' ') }} €"
                variant="{{ summary.marginCents >= 0 ? 'success' : 'error' }}" />
        {% endif %}
    </div>

    {# ── Fraîcheur ───────────────────────────────────────────────────────────── #}
    <p class="mb-6 flex items-center gap-2 text-theme-xs text-gray-500 dark:text-gray-400" aria-live="polite">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
        {% if freshnessMinutes is null %}
            Aucune valorisation pour l'instant.
        {% else %}
            Mise à jour il y a {{ freshnessMinutes }} min.
        {% endif %}
    </p>

    {# ── Ventilation par projet (US-060 T-060-04) ──────────────────────────── #}
    <section aria-labelledby="by-project-heading" class="mb-6">
        <h2 id="by-project-heading" class="mb-3 text-theme-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">Ventilation par projet</h2>
        {% if projectBreakdown is empty %}
            <p class="rounded-2xl border border-gray-200 bg-white p-4 text-theme-xs text-gray-500 shadow-theme-sm dark:border-gray-800 dark:bg-white/[0.03] dark:text-gray-400">
                Aucune valorisation aboutie à ventiler pour l'instant.
            </p>
        {% else %}
            <div class="overflow-x-auto rounded-2xl border border-gray-200 bg-white shadow-theme-sm dark:border-gray-800 dark:bg-white/[0.03]">
                <table class="w-full border-collapse text-left text-theme-sm">
                    <caption class="sr-only">CA{{ canViewCost ? ', coût et marge' : '' }} par projet</caption>
                    <thead>
                        <tr class="border-b border-gray-100 bg-gray-50 dark:border-gray-800 dark:bg-white/[0.02]">
                            <th scope="col" class="px-4 py-3 font-semibold text-gray-700 dark:text-gray-300">Projet</th>
                            <th scope="col" class="px-4 py-3 text-right font-semibold text-gray-700 dark:text-gray-300">Imputations</th>
                            <th scope="col" class="px-4 py-3 text-right font-semibold text-gray-700 dark:text-gray-300">CA reconnu</th>
                            {% if canViewCost %}
                                <th scope="col" class="px-4 py-3 text-right font-semibold text-gray-700 dark:text-gray-300">Coût chargé</th>
                                <th scope="col" class="px-4 py-3 text-right font-semibold text-gray-700 dark:text-gray-300">Marge brute</th>
                            {% endif %}
                        </tr>
                    </thead>
                    <tbody>
                        {% for line in projectBreakdown %}
                            <tr class="border-t border-gray-100 hover:bg-gray-50 dark:border-gray-800 dark:hover:bg-white/[0.02]">
                                <td class="px-4 py-3 font-medium text-gray-800 dark:text-white/90">{{ line.projectName }}</td>
                                <td class="px-4 py-3 text-right tabular-nums text-gray-600 dark:text-gray-300">{{ line.valuedCount }}</td>
                                <td class="px-4 py-3 text-right tabular-nums text-gray-800 dark:text-white/90">{{ (line.revenueCents / 100)|number_format(2, ',', ' ') }} €</td>
                                {% if canViewCost %}
                                    <td class="px-4 py-3 text-right tabular-nums text-gray-600 dark:text-gray-300">{{ (line.costCents / 100)|number_format(2, ',', ' ') }} €</td>
                                    <td class="px-4 py-3 text-right tabular-nums font-medium {{ line.marginCents >= 0 ? 'text-success-600 dark:text-success-500' : 'text-error-600 dark:text-error-500' }}">
                                        {{ (line.marginCents / 100)|number_format(2, ',', ' ') }} €
                                    </td>
                                {% endif %}
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </section>

    {# ── Occupation par collaborateur (US-060 T-060-03) ────────────────────── #}
    <section aria-labelledby="occupation-heading" class="mb-6">
        <h2 id="occupation-heading" class="mb-3 text-theme-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">
            Occupation par collaborateur{% if not occupation.rows is empty %} <span class="font-normal normal-case text-gray-500 dark:text-gray-400">— {{ occupation.month }}</span>{% endif %}
        </h2>
        {% if occupation.rows is empty %}
            <p class="rounded-2xl border border-gray-200 bg-white p-4 text-theme-xs text-gray-500 shadow-theme-sm dark:border-gray-800 dark:bg-white/[0.03] dark:text-gray-400">
                Aucune activité valorisée à mesurer pour l'instant.
            </p>
        {% else %}
            <div class="overflow-x-auto rounded-2xl border border-gray-200 bg-white shadow-theme-sm dark:border-gray-800 dark:bg-white/[0.03]">
                <table class="w-full border-collapse text-left text-theme-sm">
                    <caption class="sr-only">Taux d'occupation par collaborateur sur {{ occupation.month }} (jours valorisés sur capacité)</caption>
                    <thead>
                        <tr class="border-b border-gray-100 bg-gray-50 dark:border-gray-800 dark:bg-white/[0.02]">
                            <th scope="col" class="px-4 py-3 font-semibold text-gray-700 dark:text-gray-300">Collaborateur</th>
                            <th scope="col" class="px-4 py-3 text-right font-semibold text-gray-700 dark:text-gray-300">Jours valorisés</th>
                            <th scope="col" class="px-4 py-3 text-right font-semibold text-gray-700 dark:text-gray-300">Capacité (j)</th>
                            <th scope="col" class="px-4 py-3 text-right font-semibold text-gray-700 dark:text-gray-300">Occupation</th>
                            <th scope="col" class="px-4 py-3 text-right font-semibold text-gray-700 dark:text-gray-300">Facturable</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in occupation.rows %}
                            <tr class="border-t border-gray-100 hover:bg-gray-50 dark:border-gray-800 dark:hover:bg-white/[0.02]">
                                <td class="px-4 py-3 font-medium text-gray-800 dark:text-white/90">{{ row.name }}</td>
                                <td class="px-4 py-3 text-right tabular-nums text-gray-600 dark:text-gray-300">{{ row.valuedDays }}</td>
                                <td class="px-4 py-3 text-right tabular-nums text-gray-600 dark:text-gray-300">{{ row.capacityDays }}</td>
                                <td class="px-4 py-3">
                                    <div class="flex items-center justify-end gap-2">
                                        <div class="w-24">
                                            <twig:tsf:Ui:ProgressBar :value="row.percent" size="sm" />
                                        </div>
                                        <span class="w-10 text-right tabular-nums font-medium text-gray-800 dark:text-white/90">{{ row.percent }} %</span>
                                    </div>
                                </td>
                                <td class="px-4 py-3 text-right tabular-nums text-gray-600 dark:text-gray-300">{{ row.billablePercent is not null ? row.billablePercent ~ ' %' : '—' }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </section>

    {# ── Détail coût & marge — réservé DG / contrôle de gestion ─────────────── #}
    <h2 class="mb-3 text-theme-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">Détail des opérations</h2>
    {% if canViewCost %}
        {% if auditTrail is not empty %}
            <div class="rounded-2xl border border-gray-200 bg-white shadow-theme-sm dark:border-gray-800 dark:bg-white/[0.03]">
                <div class="border-b border-gray-100 px-4 py-3 text-theme-sm font-semibold text-gray-800 dark:border-gray-800 dark:text-white/90">Audit trail — taux appliqués</div>
                <div class="overflow-x-auto">
                    <table class="w-full border-collapse text-left text-theme-sm">
                        <caption class="sr-only">Détail des taux appliqués par imputation valorisée</caption>
                        <thead>
                            <tr class="border-b border-gray-100 bg-gray-50 dark:border-gray-800 dark:bg-white/[0.02]">
                                <th scope="col" class="px-4 py-3 font-semibold text-gray-700 dark:text-gray-300">Imputation</th>
                                <th scope="col" class="px-4 py-3 font-semibold text-gray-700 dark:text-gray-300">Valorisée le</th>
                                <th scope="col" class="px-4 py-3 text-right font-semibold text-gray-700 dark:text-gray-300">CA (€)</th>
                                <th scope="col" class="px-4 py-3 text-right font-semibold text-gray-700 dark:text-gray-300">Coût (€)</th>
                                <th scope="col" class="px-4 py-3 font-semibold text-gray-700 dark:text-gray-300">Taux appliqué</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for line in auditTrail %}
                                <tr class="border-t border-gray-100 hover:bg-gray-50 dark:border-gray-800 dark:hover:bg-white/[0.02]">
                                    <td class="px-4 py-3">
                                        <code class="rounded bg-gray-100 px-1 py-0.5 font-mono text-theme-xs text-gray-600 dark:bg-white/[0.06] dark:text-gray-300">{{ line.timeEntryId[:8] }}</code>
                                    </td>
                                    <td class="px-4 py-3 text-gray-600 dark:text-gray-300">{{ line.valuedAt }}</td>
                                    <td class="px-4 py-3 text-right tabular-nums text-gray-600 dark:text-gray-300">{{ (line.revenueCents / 100)|number_format(2, ',', ' ') }}</td>
                                    <td class="px-4 py-3 text-right tabular-nums text-gray-600 dark:text-gray-300">{{ (line.costCents / 100)|number_format(2, ',', ' ') }}</td>
                                    <td class="px-4 py-3">
                                        <details>
                                            <summary class="cursor-pointer list-none text-theme-xs font-medium text-brand-500 hover:underline dark:text-brand-400 [&::-webkit-details-marker]:hidden"
                                                     aria-label="Afficher le détail du taux appliqué">Taux appliqué</summary>
                                            <p class="mt-1 text-theme-xs text-gray-500 dark:text-gray-400">
                                                Vente : {{ (line.sellingRateCents / 100)|number_format(2, ',', ' ') }} €/j —
                                                Coût : {{ (line.costRateCents / 100)|number_format(2, ',', ' ') }} €/j
                                                {% if line.rateDate %}— en vigueur au {{ line.rateDate }}{% endif %}
                                            </p>
                                        </details>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        {% else %}
            <div class="rounded-2xl border border-gray-200 bg-white p-4 shadow-theme-sm dark:border-gray-800 dark:bg-white/[0.03]">
                <p class="m-0 text-theme-sm text-gray-500 dark:text-gray-400">Aucune imputation valorisée à détailler.</p>
            </div>
        {% endif %}
    {% else %}
        <div class="flex items-center gap-2 rounded-2xl border border-gray-200 bg-white p-4 shadow-theme-sm dark:border-gray-800 dark:bg-white/[0.03]">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0 text-gray-400"><rect x="3" y="11" width="18" height="10" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            <p class="m-0 text-theme-sm text-gray-500 dark:text-gray-400">
                Le détail des coûts et des taux est réservé au contrôle de gestion.
            </p>
        </div>
    {% endif %}
{% endblock %}
