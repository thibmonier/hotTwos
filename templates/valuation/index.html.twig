{% extends 'base.html.twig' %}

{% block title %}Tableau de bord financier{% endblock %}

{% block page_section %}Finance &amp; rentabilité{% endblock %}
{% block page_title %}Valorisation du temps validé{% endblock %}

{% block body %}
    {# H1 visible par les lecteurs d'écran et attendu par les tests (sous-chaîne "tableau de bord financier") #}
    <h1 class="visually-hidden">tableau de bord financier</h1>

    {# ── Alerte valorisation incomplète ─────────────────────────────────────── #}
    {% if summary.hasIncompleteValuations %}
        <div class="mb-4 flex items-start gap-3 rounded border-l-4 border-warning bg-surface px-4 py-3 text-warning" role="alert">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="mt-0.5 shrink-0"><path d="M12 9v4M12 17h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/></svg>
            <div>
                <strong>Valorisation incomplète</strong> —
                {{ summary.missingRate }} imputation{{ summary.missingRate > 1 ? 's' : '' }} sans tarif.
                Renseignez le tarif du profil concerné pour compléter le calcul (relance automatique).
            </div>
        </div>
    {% endif %}

    {# ── KPI row ─────────────────────────────────────────────────────────────── #}
    <h2 class="mb-3 text-xs font-semibold uppercase tracking-wider text-muted">Indicateurs clés</h2>

    {# Grille 4 colonnes ; sans accès coût : CA(1 col) + Avancement(3 cols). #}
    <div class="mb-6 grid grid-cols-1 gap-4 sm:grid-cols-4">

        {# CA reconnu — indicateur vedette : mis en avant (teinte primary, chiffre plus grand) #}
        <div class="sm:col-span-1">
            <div class="flex h-full flex-col rounded-md border border-primary/20 bg-primary/5 p-5 shadow-sm">
                <div class="mb-2 flex items-center justify-between">
                    <span class="text-xs font-medium text-muted">CA reconnu</span>
                    <span class="grid h-10 w-10 shrink-0 place-items-center rounded-lg bg-primary-surface text-primary" aria-hidden="true">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 1v22M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                    </span>
                </div>
                <div class="text-3xl font-semibold tabular-nums text-ink">
                    {{ (summary.revenueCents / 100)|number_format(2, ',', ' ') }} €
                </div>
            </div>
        </div>

        {# Avancement — toujours visible ; prend 3 colonnes quand le coût est masqué #}
        <div class="{{ canViewCost ? 'sm:col-span-1' : 'sm:col-span-3' }}">
            <div class="flex h-full flex-col rounded-md border border-border bg-surface p-5 shadow-sm">
                <div class="mb-1 text-xs font-medium text-muted">Avancement valorisation</div>
                <div class="mb-3 font-semibold tabular-nums text-ink">
                    {{ summary.valued }} / {{ summary.total }} imputations valorisées
                </div>
                <div class="mt-auto h-2 overflow-hidden rounded-full bg-border"
                     role="progressbar"
                     aria-valuenow="{{ summary.valued }}"
                     aria-valuemin="0"
                     aria-valuemax="{{ summary.total ?: 1 }}"
                     aria-label="Progression : {{ summary.valued }} sur {{ summary.total }} imputations valorisées">
                    <div class="h-full rounded-full bg-primary transition-all duration-300"
                         style="width:{{ summary.total ? ((summary.valued / summary.total) * 100)|round : 0 }}%;"></div>
                </div>
            </div>
        </div>

        {% if canViewCost %}
            {# Coût chargé — DG / contrôle de gestion #}
            <div class="sm:col-span-1">
                <div class="flex h-full flex-col rounded-md border border-border bg-surface p-5 shadow-sm">
                    <div class="mb-2 flex items-center justify-between">
                        <span class="text-xs font-medium text-muted">Coût chargé</span>
                        <span class="grid h-10 w-10 shrink-0 place-items-center rounded-lg bg-surface-alt text-muted" aria-hidden="true">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg>
                        </span>
                    </div>
                    <div class="text-2xl font-semibold tabular-nums text-ink">
                        {{ (summary.costCents / 100)|number_format(2, ',', ' ') }} €
                    </div>
                </div>
            </div>

            {# Marge brute — DG / contrôle de gestion #}
            <div class="sm:col-span-1">
                <div class="flex h-full flex-col rounded-md border border-border bg-surface p-5 shadow-sm">
                    <div class="mb-2 flex items-center justify-between">
                        <span class="text-xs font-medium text-muted">Marge brute</span>
                        <span class="grid h-10 w-10 shrink-0 place-items-center rounded-lg bg-surface-alt text-success" aria-hidden="true">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19V5M4 19h16M8 15l3-4 3 2 4-6"/></svg>
                        </span>
                    </div>
                    <div class="text-2xl font-semibold tabular-nums text-ink">
                        {{ (summary.marginCents / 100)|number_format(2, ',', ' ') }} €
                    </div>
                </div>
            </div>
        {% endif %}

    </div>

    {# ── Fraîcheur ───────────────────────────────────────────────────────────── #}
    <p class="mb-6 flex items-center gap-2 text-xs text-muted" aria-live="polite">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
        {% if freshnessMinutes is null %}
            Aucune valorisation pour l'instant.
        {% else %}
            Mise à jour il y a {{ freshnessMinutes }} min.
        {% endif %}
    </p>

    {# ── Ventilation par projet (US-060 T-060-04) ──────────────────────────── #}
    <section aria-labelledby="by-project-heading" class="mb-6">
        <h2 id="by-project-heading" class="mb-3 text-xs font-semibold uppercase tracking-wider text-muted">Ventilation par projet</h2>
        {% if projectBreakdown is empty %}
            <p class="rounded-md border border-border bg-surface p-4 text-xs text-muted shadow-sm">
                Aucune valorisation aboutie à ventiler pour l'instant.
            </p>
        {% else %}
            <div class="overflow-x-auto rounded-md border border-border bg-surface shadow-sm">
                <table class="w-full border-collapse text-left">
                    <caption class="visually-hidden">CA{{ canViewCost ? ', coût et marge' : '' }} par projet</caption>
                    <thead>
                        <tr class="bg-surface-alt text-xs">
                            <th scope="col" class="px-4 py-3 font-semibold text-body">Projet</th>
                            <th scope="col" class="px-4 py-3 text-right font-semibold text-body">Imputations</th>
                            <th scope="col" class="px-4 py-3 text-right font-semibold text-body">CA reconnu</th>
                            {% if canViewCost %}
                                <th scope="col" class="px-4 py-3 text-right font-semibold text-body">Coût chargé</th>
                                <th scope="col" class="px-4 py-3 text-right font-semibold text-body">Marge brute</th>
                            {% endif %}
                        </tr>
                    </thead>
                    <tbody>
                        {% for line in projectBreakdown %}
                            <tr class="border-t border-border text-xs">
                                <td class="px-4 py-3 font-medium text-ink">{{ line.projectName }}</td>
                                <td class="px-4 py-3 text-right tabular-nums text-body">{{ line.valuedCount }}</td>
                                <td class="px-4 py-3 text-right tabular-nums text-ink">{{ (line.revenueCents / 100)|number_format(2, ',', ' ') }} €</td>
                                {% if canViewCost %}
                                    <td class="px-4 py-3 text-right tabular-nums text-body">{{ (line.costCents / 100)|number_format(2, ',', ' ') }} €</td>
                                    <td class="px-4 py-3 text-right tabular-nums font-medium {{ line.marginCents >= 0 ? 'text-success' : 'text-danger' }}">
                                        {{ (line.marginCents / 100)|number_format(2, ',', ' ') }} €
                                    </td>
                                {% endif %}
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </section>

    {# ── Détail coût & marge — réservé DG / contrôle de gestion ─────────────── #}
    <h2 class="mb-3 text-xs font-semibold uppercase tracking-wider text-muted">Détail des opérations</h2>
    {% if canViewCost %}
        {% if auditTrail is not empty %}
            <div class="rounded-md border border-border bg-surface shadow-sm">
                <div class="border-b border-border px-4 py-3 font-semibold text-ink">Audit trail — taux appliqués</div>
                <div class="overflow-x-auto">
                    <table class="w-full border-collapse text-left">
                        <caption class="visually-hidden">Détail des taux appliqués par imputation valorisée</caption>
                        <thead>
                            <tr class="bg-surface-alt">
                                <th scope="col" class="px-4 py-3 font-semibold text-body">Imputation</th>
                                <th scope="col" class="px-4 py-3 font-semibold text-body">Valorisée le</th>
                                <th scope="col" class="px-4 py-3 text-right font-semibold text-body">CA (€)</th>
                                <th scope="col" class="px-4 py-3 text-right font-semibold text-body">Coût (€)</th>
                                <th scope="col" class="px-4 py-3 font-semibold text-body">Taux appliqué</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for line in auditTrail %}
                                <tr class="border-t border-border hover:bg-surface-alt">
                                    <td class="px-4 py-3">
                                        <code class="rounded bg-surface-alt px-1 py-0.5 font-mono text-xs text-body">{{ line.timeEntryId[:8] }}</code>
                                    </td>
                                    <td class="px-4 py-3 text-body">{{ line.valuedAt }}</td>
                                    <td class="px-4 py-3 text-right text-body">{{ (line.revenueCents / 100)|number_format(2, ',', ' ') }}</td>
                                    <td class="px-4 py-3 text-right text-body">{{ (line.costCents / 100)|number_format(2, ',', ' ') }}</td>
                                    <td class="px-4 py-3">
                                        <details>
                                            <summary class="cursor-pointer list-none text-xs font-medium text-primary hover:underline [&::-webkit-details-marker]:hidden"
                                                     aria-label="Afficher le détail du taux appliqué">Taux appliqué</summary>
                                            <p class="mt-1 text-xs text-muted">
                                                Vente : {{ (line.sellingRateCents / 100)|number_format(2, ',', ' ') }} €/j —
                                                Coût : {{ (line.costRateCents / 100)|number_format(2, ',', ' ') }} €/j
                                                {% if line.rateDate %}— en vigueur au {{ line.rateDate }}{% endif %}
                                            </p>
                                        </details>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        {% else %}
            <div class="rounded-md border border-border bg-surface p-4">
                <p class="m-0 text-muted">Aucune imputation valorisée à détailler.</p>
            </div>
        {% endif %}
    {% else %}
        <div class="flex items-center gap-2 rounded-md border border-border bg-surface p-4">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0 text-muted"><rect x="3" y="11" width="18" height="10" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            <p class="m-0 text-muted">
                Le détail des coûts et des taux est réservé au contrôle de gestion.
            </p>
        </div>
    {% endif %}
{% endblock %}
