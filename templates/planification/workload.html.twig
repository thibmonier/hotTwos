{% extends 'base.html.twig' %}

{% block title %}Plan de charge{% endblock %}
{% block page_section %}Planification{% endblock %}
{% block page_title %}Plan de charge — {{ plan.period }}{% endblock %}

{% block body %}
    <h1 class="visually-hidden">plan de charge</h1>

    <p class="mb-4 max-w-2xl text-sm text-muted">
        Capacité (jours ouvrés nets d'absences, selon le régime de travail) vs charge ferme (jours
        affectés) par collaborateur. La charge probable (pipeline) n'est pas encore disponible.
    </p>

    <div class="overflow-x-auto">
        <table class="w-full border-collapse text-sm">
            <caption class="sr-only">Plan de charge par collaborateur</caption>
            <thead>
                <tr class="border-b-2 border-border text-left text-xs uppercase text-muted">
                    <th scope="col" class="py-2 pr-4">Collaborateur</th>
                    <th scope="col" class="py-2 pr-4 text-right">Capacité (j)</th>
                    <th scope="col" class="py-2 pr-4 text-right">Charge ferme (j)</th>
                    <th scope="col" class="py-2 pr-4 text-right">Disponible (j)</th>
                    <th scope="col" class="py-2">État</th>
                </tr>
            </thead>
            <tbody>
                {% for line in plan.lines %}
                    <tr class="border-b border-border">
                        <th scope="row" class="py-2 pr-4 font-medium text-ink">{{ line.displayName }}</th>
                        <td class="py-2 pr-4 text-right tabular-nums">{{ line.capacityDays }}</td>
                        <td class="py-2 pr-4 text-right tabular-nums">{{ line.firmLoadDays }}</td>
                        <td class="py-2 pr-4 text-right tabular-nums">{{ line.availableDays }}</td>
                        <td class="py-2">
                            {% if line.isOverloaded %}
                                <span class="rounded bg-danger/10 px-2 py-0.5 text-xs font-semibold text-danger">Surcharge</span>
                            {% elseif line.availableDays == 0 %}
                                <span class="text-muted">Plein</span>
                            {% else %}
                                <span class="rounded bg-success/10 px-2 py-0.5 text-xs font-semibold text-success">Disponible</span>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="5" class="py-4 text-center text-muted">Aucun collaborateur.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
