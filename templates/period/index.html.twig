{% extends 'base.html.twig' %}

{% block title %}Administration des périodes{% endblock %}

{% block page_section %}Administration{% endblock %}
{% block page_title %}Périodes comptables{% endblock %}

{% block body %}
    <twig:tsf:Layout:PageHeader
        title="Périodes comptables"
        subtitle="Statut des périodes comptables et clôture (figement des marges)" />

    {# Messages flash — .flash-success et .flash-error assertés par PeriodAdminTest #}
    {% for message in app.flashes('success') %}
        <div class="flash flash-success mb-3" role="status">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="flash flash-error mb-3" role="alert">{{ message }}</div>
    {% endfor %}

    {# Liste des périodes #}
    <section aria-labelledby="periods-heading" class="mb-6">
        <h2 id="periods-heading" class="mb-3 text-theme-sm font-semibold text-gray-800 dark:text-white/90">Périodes</h2>

        {% if periods is empty %}
            <p class="text-theme-sm text-gray-500 dark:text-gray-400">Aucune période clôturée pour l'instant.</p>
        {% else %}
            <div class="overflow-x-auto rounded-2xl border border-gray-200 bg-white shadow-theme-sm dark:border-gray-800 dark:bg-white/[0.03]">
                <table class="w-full border-collapse text-left text-theme-sm">
                    <caption class="sr-only">Liste des périodes comptables et leur statut</caption>
                    <thead>
                        <tr class="border-b border-gray-100 bg-gray-50 text-theme-xs uppercase dark:border-gray-800 dark:bg-white/[0.02]">
                            <th scope="col" class="px-4 py-3 font-semibold text-gray-700 dark:text-gray-300">Période</th>
                            <th scope="col" class="px-4 py-3 font-semibold text-gray-700 dark:text-gray-300">Statut</th>
                            <th scope="col" class="px-4 py-3 font-semibold text-gray-700 dark:text-gray-300">Clôturée le</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for p in periods %}
                            <tr class="border-t border-gray-100 dark:border-gray-800">
                                <td class="px-4 py-3 font-medium text-gray-800 dark:text-white/90">{{ p.period }}</td>
                                <td class="px-4 py-3">
                                    {% if p.status == 'closed' %}
                                        <span class="inline-flex items-center rounded-full bg-gray-100 px-2 py-0.5 text-theme-xs font-medium text-gray-600 dark:bg-white/[0.06] dark:text-gray-300">Clôturée</span>
                                    {% elseif p.status == 'closing' %}
                                        <span class="inline-flex items-center rounded-full bg-warning-50 px-2 py-0.5 text-theme-xs font-medium text-warning-700 dark:bg-warning-500/15 dark:text-warning-400">En clôture</span>
                                    {% else %}
                                        <span class="inline-flex items-center rounded-full bg-success-50 px-2 py-0.5 text-theme-xs font-medium text-success-700 dark:bg-success-500/15 dark:text-success-400">Ouverte</span>
                                    {% endif %}
                                </td>
                                <td class="px-4 py-3 text-gray-500 dark:text-gray-400">{{ p.closedAt ?? '—' }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </section>

    {# Formulaire de clôture #}
    <section aria-labelledby="close-heading" class="mb-6">
        <h2 id="close-heading" class="mb-3 text-theme-sm font-semibold text-gray-800 dark:text-white/90">Clôturer une période</h2>

        <div class="max-w-md rounded-2xl border border-gray-200 bg-white p-4 shadow-theme-sm dark:border-gray-800 dark:bg-white/[0.03]">
            <form method="post" action="{{ path('period_close') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('close_period') }}">

                <div class="mb-4">
                    <label for="period-code" class="mb-1 block text-theme-xs font-medium text-gray-700 dark:text-gray-300">
                        Période <span class="font-normal text-gray-500 dark:text-gray-400">(YYYY-MM)</span>
                    </label>
                    <input type="text" id="period-code" name="period" required
                           pattern="\d{4}-(0[1-9]|1[0-2])" placeholder="2026-08"
                           class="min-h-10 w-full max-w-xs rounded-lg border border-gray-300 bg-white px-3 text-theme-sm text-gray-700 placeholder:text-gray-400 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/40 dark:border-gray-700 dark:bg-white/[0.03] dark:text-gray-300">
                </div>

                <div class="mb-4">
                    <label for="period-confirmation" class="mb-1 block text-theme-xs font-medium text-gray-700 dark:text-gray-300">
                        Confirmation — ressaisir le code de la période
                    </label>
                    <input type="text" id="period-confirmation" name="confirmation" required
                           placeholder="2026-08" aria-describedby="confirm-help"
                           class="min-h-10 w-full max-w-xs rounded-lg border border-gray-300 bg-white px-3 text-theme-sm text-gray-700 placeholder:text-gray-400 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/40 dark:border-gray-700 dark:bg-white/[0.03] dark:text-gray-300">
                    <p id="confirm-help" class="mt-1 text-theme-xs text-gray-500 dark:text-gray-400">
                        Pour éviter une clôture accidentelle, ressaisissez le code exact de la période.
                    </p>
                </div>

                <div class="mb-4 flex items-start gap-2">
                    <input type="checkbox" id="period-force" name="force" value="1"
                           class="mt-0.5 h-4 w-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500/40 dark:border-gray-700">
                    <label for="period-force" class="text-theme-sm text-gray-700 dark:text-gray-300">
                        Clôturer malgré des imputations non finalisées
                    </label>
                </div>

                <twig:tsf:Ui:Button type="submit" variant="danger">Clôturer la période</twig:tsf:Ui:Button>
            </form>
        </div>
    </section>
{% endblock %}
