{% extends 'base.html.twig' %}

{% block title %}Administration des périodes{% endblock %}

{% block page_section %}Administration{% endblock %}
{% block page_title %}Périodes comptables{% endblock %}

{% block body %}
    <h1 class="visually-hidden">Périodes comptables</h1>

    {#Messages flash — .flash-success et .flash-error assertés par PeriodAdminTest #}
    {% for message in app.flashes('success') %}
        <div class="ds-alert ds-alert-success flash-success mb-3" role="status">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="ds-alert ds-alert-danger flash-error mb-3" role="alert">{{ message }}</div>
    {% endfor %}

    {#Liste des périodes #}
    <section aria-labelledby="periods-heading" class="mb-4">
        <h2 id="periods-heading" class="fs-5 fw-semibold mb-3">Périodes</h2>

        {% if periods is empty %}
            <p class="text-muted">Aucune période clôturée pour l'instant.</p>
        {% else %}
            <div class="table-responsive">
                <table class="table table-hover table-compact">
                    <caption class="visually-hidden">Liste des périodes comptables et leur statut</caption>
                    <thead>
                        <tr>
                            <th scope="col">Période</th>
                            <th scope="col">Statut</th>
                            <th scope="col">Clôturée le</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for p in periods %}
                            <tr>
                                <td class="fw-medium">{{ p.period }}</td>
                                <td>
                                    {% if p.status == 'closed' %}
                                        <span class="status-badge status-badge-closed">Clôturée</span>
                                    {% elseif p.status == 'closing' %}
                                        <span class="status-badge status-badge-warning">En clôture</span>
                                    {% else %}
                                        <span class="status-badge status-badge-success">Ouverte</span>
                                    {% endif %}
                                </td>
                                <td class="text-muted">{{ p.closedAt ?? '—' }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </section>

    {#Formulaire de clôture #}
    <section aria-labelledby="close-heading" class="mb-4">
        <h2 id="close-heading" class="fs-5 fw-semibold mb-3">Clôturer une période</h2>
        <div class="card">
            <div class="card-body">
                <form method="post" action="{{ path('period_close') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('close_period') }}">

                    <div class="mb-3">
                        <label for="period-code" class="form-label">Période <span class="text-muted fw-normal">(YYYY-MM)</span></label>
                        <input type="text" id="period-code" class="form-control" name="period" required
                               pattern="\d{4}-(0[1-9]|1[0-2])" placeholder="2026-08">
                    </div>

                    <div class="mb-3">
                        <label for="period-confirmation" class="form-label">
                            Confirmation — ressaisir le code de la période
                        </label>
                        <input type="text" id="period-confirmation" class="form-control"
                               name="confirmation" required placeholder="2026-08"
                               aria-describedby="confirm-help">
                        <div id="confirm-help" class="form-text text-muted">
                            Pour éviter une clôture accidentelle, ressaisissez le code exact de la période.
                        </div>
                    </div>

                    <div class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input" id="period-force"
                               name="force" value="1">
                        <label class="form-check-label" for="period-force">
                            Clôturer malgré des imputations non finalisées
                        </label>
                    </div>

                    <button type="submit" class="btn btn-danger btn-sm">Clôturer la période</button>
                </form>
            </div>
        </div>
    </section>
{% endblock %}
