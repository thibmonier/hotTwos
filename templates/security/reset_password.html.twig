{% extends 'base.html.twig' %}

{% block title %}Nouveau mot de passe — HotOnes{% endblock %}
{% block page_title 'Nouveau mot de passe' %}

{% block body %}
    <div class="mx-auto mt-10 w-full max-w-sm">
        <div class="rounded-md border border-border bg-surface p-6 shadow-sm">
            <h1 class="mb-1 text-lg font-semibold text-ink">Définir un nouveau mot de passe</h1>
            <p class="mb-5 text-sm text-muted">Choisissez un mot de passe d'au moins 12 caractères.</p>

            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="mb-4 rounded border px-3 py-2 text-sm {{ label == 'error' ? 'border-danger text-danger' : 'border-success text-success' }}"
                         role="{{ label == 'error' ? 'alert' : 'status' }}">{{ message }}</div>
                {% endfor %}
            {% endfor %}

            <form method="post" action="{{ path('reset_password') }}" class="flex flex-col gap-4">
                <div class="flex flex-col gap-1">
                    <label for="newPassword" class="text-sm font-medium text-body">Nouveau mot de passe</label>
                    <input type="password" id="newPassword" name="new_password" minlength="12"
                           autocomplete="new-password" required autofocus
                           class="min-h-11 rounded border border-border-strong bg-surface px-3 text-sm text-ink focus:border-primary">
                </div>
                <div class="flex flex-col gap-1">
                    <label for="confirmPassword" class="text-sm font-medium text-body">Confirmer le mot de passe</label>
                    <input type="password" id="confirmPassword" name="confirm_password" minlength="12"
                           autocomplete="new-password" required
                           class="min-h-11 rounded border border-border-strong bg-surface px-3 text-sm text-ink focus:border-primary">
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('reset_password') }}">

                <button type="submit"
                        class="inline-flex min-h-11 items-center justify-center rounded bg-primary px-4 text-sm font-semibold text-white hover:opacity-90">
                    Réinitialiser
                </button>
            </form>
        </div>
    </div>
{% endblock %}
