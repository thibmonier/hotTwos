{% extends 'base.html.twig' %}

{% block title %}Connexion — HotOnes{% endblock %}
{% block page_title 'Connexion' %}

{% block body %}
    <div class="mx-auto mt-10 w-full max-w-sm">
        <div class="rounded-md border border-border bg-surface p-6 shadow-sm">
            <h1 class="mb-1 text-lg font-semibold text-ink">Connexion</h1>
            <p class="mb-5 text-sm text-muted">Accédez à votre espace HotOnes.</p>

            {% if has_error %}
                <div class="flash-error mb-4 rounded border border-danger px-3 py-2 text-sm text-danger" role="alert">
                    Identifiants invalides.
                </div>
            {% endif %}

            <form method="post" action="{{ path('login') }}" class="flex flex-col gap-4">
                <div class="flex flex-col gap-1">
                    <label for="inputEmail" class="text-sm font-medium text-body">Adresse e-mail</label>
                    <input type="email" id="inputEmail" name="_username" value="{{ last_username }}"
                           autocomplete="email" required autofocus
                           class="min-h-11 rounded border border-border-strong bg-surface px-3 text-sm text-ink focus:border-primary">
                </div>
                <div class="flex flex-col gap-1">
                    <label for="inputPassword" class="text-sm font-medium text-body">Mot de passe</label>
                    <input type="password" id="inputPassword" name="_password"
                           autocomplete="current-password" required
                           class="min-h-11 rounded border border-border-strong bg-surface px-3 text-sm text-ink focus:border-primary">
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button type="submit"
                        class="inline-flex min-h-11 items-center justify-center rounded bg-primary px-4 text-sm font-semibold text-white hover:opacity-90">
                    Se connecter
                </button>
            </form>
        </div>

        <p class="mt-4 text-center text-xs text-muted">
            Mot de passe oublié ? Contactez votre administrateur.
        </p>
    </div>
{% endblock %}
