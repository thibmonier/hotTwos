{% extends 'base.html.twig' %}

{% block title %}Validation des temps{% endblock %}

{% block page_section %}Temps &amp; activité{% endblock %}
{% block page_title %}Validation des temps{% endblock %}

{% block body %}
    <h1 class="visually-hidden">Validation des temps</h1>

    {# ── En-tête de section ──────────────────────────────────────────────────── #}
    <div class="mb-4 flex items-center justify-between">
        <div>
            <h2 class="m-0 text-base font-semibold text-ink">Ma responsabilité</h2>
            <p class="m-0 text-sm text-muted">Imputations en attente de validation sur vos projets</p>
        </div>
    </div>

    {# ── Contenu principal — contrôleur Stimulus ─────────────────────────────── #}
    <div data-controller="validation">

        {% if not hasProjects %}
            <div class="rounded-md border border-border bg-surface p-4 text-muted">
                Vous n'êtes responsable d'aucun projet : aucune imputation à valider.
            </div>
        {% elseif rows is empty %}
            <div class="flex items-center gap-2 rounded-md border border-border bg-surface p-4">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0 text-success"><path d="M20 6 9 17l-5-5"/></svg>
                <span class="text-body">Aucune imputation en attente sur vos projets.</span>
            </div>
        {% else %}
            <div class="rounded-md border border-border bg-surface">
                <form data-action="submit->validation#submit">
                    <div class="overflow-x-auto">
                        <table class="w-full border-collapse text-left">
                            <caption class="visually-hidden">Imputations en attente de validation</caption>
                            <thead>
                                <tr class="bg-surface-alt">
                                    <th scope="col" class="w-11 px-4 py-3">
                                        <input type="checkbox"
                                               class="h-4 w-4 cursor-pointer accent-primary"
                                               data-action="validation#toggleAll"
                                               aria-label="Tout sélectionner">
                                    </th>
                                    <th scope="col" class="px-4 py-3 font-semibold text-body">Projet</th>
                                    <th scope="col" class="px-4 py-3 font-semibold text-body">Jour</th>
                                    <th scope="col" class="px-4 py-3 text-right font-semibold text-body">Minutes</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for row in rows %}
                                    <tr class="border-t border-border hover:bg-surface-alt">
                                        <td class="px-4 py-3">
                                            <input type="checkbox"
                                                   class="h-4 w-4 cursor-pointer accent-primary"
                                                   value="{{ row.id }}"
                                                   data-validation-target="entry"
                                                   aria-label="Sélectionner l'imputation {{ row.project }} {{ row.date }}">
                                        </td>
                                        <td class="px-4 py-3 text-body">{{ row.project }}</td>
                                        <td class="px-4 py-3 text-body">{{ row.date }}</td>
                                        <td class="px-4 py-3 text-right text-body">{{ row.minutes }}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>

                    {# ── Actions de validation ───────────────────────────────────── #}
                    <div class="flex flex-wrap items-center gap-3 border-t border-border p-3">
                        <button type="button"
                                class="inline-flex min-h-11 items-center rounded border border-success px-3 py-1.5 text-xs font-semibold text-success transition-colors hover:bg-success hover:text-on-status"
                                data-action="validation#validate">
                            Valider la sélection
                        </button>

                        <div class="flex flex-1 items-center gap-2">
                            <label for="validation-reason" class="whitespace-nowrap text-xs font-normal text-muted">
                                Motif de refus
                            </label>
                            <input type="text"
                                   id="validation-reason"
                                   class="min-h-11 flex-1 rounded border border-border bg-surface px-3 py-2 text-xs text-body placeholder:text-muted focus:border-primary"
                                   data-validation-target="reason"
                                   placeholder="obligatoire pour refuser"
                                   aria-describedby="validation-reason-hint">
                            <div id="validation-reason-hint" class="visually-hidden">Le motif de refus est obligatoire pour refuser une sélection.</div>
                        </div>

                        <button type="button"
                                class="inline-flex min-h-11 items-center rounded border border-danger px-3 py-1.5 text-xs font-semibold text-danger transition-colors hover:bg-danger hover:text-on-status"
                                data-action="validation#reject">
                            Refuser la sélection
                        </button>
                    </div>
                </form>
            </div>

            <p class="mt-2 text-xs text-muted" aria-live="polite" data-validation-target="status"></p>
        {% endif %}

    </div>{# /[data-controller="validation"] #}
{% endblock %}
