{% extends 'base.html.twig' %}

{% block title %}Validation des temps{% endblock %}

{% block page_section %}Temps &amp; activité{% endblock %}
{% block page_title %}Validation des temps{% endblock %}

{% block body %}
    <h1 class="visually-hidden">Validation des temps</h1>

    {# ── En-tête de section ──────────────────────────────────────────────────── #}
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h2 class="fs-5 fw-semibold mb-0">Ma responsabilité</h2>
            <p class="text-muted mb-0" style="font-size:.875rem;">Imputations en attente de validation sur vos projets</p>
        </div>
    </div>

    {# ── Contenu principal — contrôleur Stimulus ─────────────────────────────── #}
    <div data-controller="validation">

        {% if not hasProjects %}
            <div class="card">
                <div class="card-body text-muted">
                    Vous n'êtes responsable d'aucun projet : aucune imputation à valider.
                </div>
            </div>
        {% elseif rows is empty %}
            <div class="card">
                <div class="card-body d-flex align-items-center gap-2">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color:var(--color-status-success);flex-shrink:0;"><path d="M20 6 9 17l-5-5"/></svg>
                    <span>Aucune imputation en attente sur vos projets.</span>
                </div>
            </div>
        {% else %}
            <div class="card">
                <div class="card-body p-0">
                    <form data-action="submit->validation#submit">
                        <div class="table-responsive">
                            <table class="table table-hover table-compact mb-0">
                                <caption class="visually-hidden">Imputations en attente de validation</caption>
                                <thead>
                                    <tr>
                                        <th scope="col" style="width:44px;">
                                            <input type="checkbox"
                                                   class="form-check-input"
                                                   data-action="validation#toggleAll"
                                                   aria-label="Tout sélectionner">
                                        </th>
                                        <th scope="col">Projet</th>
                                        <th scope="col">Jour</th>
                                        <th scope="col" class="text-end">Minutes</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for row in rows %}
                                        <tr>
                                            <td>
                                                <input type="checkbox"
                                                       class="form-check-input"
                                                       value="{{ row.id }}"
                                                       data-validation-target="entry"
                                                       aria-label="Sélectionner l'imputation {{ row.project }} {{ row.date }}">
                                            </td>
                                            <td>{{ row.project }}</td>
                                            <td>{{ row.date }}</td>
                                            <td class="text-end">{{ row.minutes }}</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>

                        {# ── Actions de validation ───────────────────────────────────── #}
                        <div class="d-flex flex-wrap align-items-center gap-3 p-3 border-top" style="border-color:var(--color-border-subtle);">
                            <button type="button"
                                    class="btn btn-success btn-sm"
                                    data-action="validation#validate">
                                Valider la sélection
                            </button>

                            <div class="d-flex align-items-center gap-2 flex-grow-1">
                                <label for="validation-reason" class="form-label mb-0 text-nowrap fw-normal text-muted" style="font-size:.875rem;">
                                    Motif de refus
                                </label>
                                <input type="text"
                                       id="validation-reason"
                                       class="form-control form-control-sm"
                                       data-validation-target="reason"
                                       placeholder="obligatoire pour refuser"
                                       aria-describedby="validation-reason-hint">
                                <div id="validation-reason-hint" class="visually-hidden">Le motif de refus est obligatoire pour refuser une sélection.</div>
                            </div>

                            <button type="button"
                                    class="btn btn-danger btn-sm"
                                    data-action="validation#reject">
                                Refuser la sélection
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <p class="text-muted mt-2 mb-0" style="font-size:.875rem;" aria-live="polite" data-validation-target="status"></p>
        {% endif %}

    </div>{# /[data-controller="validation"] #}
{% endblock %}
