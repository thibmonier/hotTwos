{% extends 'base.html.twig' %}

{% block title %}Saisie du temps — {{ weekLabel }}{% endblock %}

{% block body %}
    <main class="container" data-controller="timesheet" data-timesheet-week-start-value="{{ weekStart }}">
        <h1>Saisie du temps</h1>

        {% if reminderLateWeeks %}
            <p class="reminder-banner" role="status">
                <span aria-hidden="true">⏳</span>
                Vous avez désactivé les relances automatiques. Il vous reste {{ reminderLateWeeks }} semaine{{ reminderLateWeeks > 1 ? 's' : '' }} en retard à compléter.
            </p>
        {% endif %}

        <nav class="week-nav">
            <a href="{{ path('timesheet_week', { date: prevDate }) }}" rel="prev">← Semaine précédente</a>
            <strong>{{ weekLabel }}</strong>
            <a href="{{ path('timesheet_week', { date: nextDate }) }}" rel="next">Semaine suivante →</a>
        </nav>

        <p><a href="{{ path('timesheet_day', { date: weekStart }) }}">Vue jour (mobile)</a></p>

        <div data-controller="activity-summary">
            <button type="button" data-activity-summary-target="trigger" data-action="activity-summary#open">📊 Ma synthèse</button>

            <dialog class="summary-dialog" aria-labelledby="summary-title" data-activity-summary-target="dialog">
                <div class="summary-header">
                    <h2 id="summary-title">Ma synthèse</h2>
                    <button type="button" class="summary-close" data-action="activity-summary#close" aria-label="Fermer la synthèse">✕ Fermer</button>
                </div>
                <p class="hint">Période du {{ summary.periodStart }} au {{ summary.periodEnd }}.</p>

                {% if summary.empty %}
                    <p>Aucune saisie enregistrée sur cette période.</p>
                {% else %}
                    <section aria-labelledby="summary-occupation">
                        <h3 id="summary-occupation">Taux d'occupation : {{ summary.occupationPercent }} %</h3>
                        <p class="hint">Part du temps de production déclaré sur les jours ouvrés de la période.</p>
                        <div class="summary-bar"><span class="summary-bar-fill" style="width: {{ summary.occupationPercent > 100 ? 100 : summary.occupationPercent }}%" aria-hidden="true"></span></div>
                    </section>

                    <section aria-labelledby="summary-type">
                        <h3 id="summary-type">Répartition par type</h3>
                        <ul class="summary-list">
                            <li>Production — {{ summary.productionDuration }} ({{ summary.productionPercent }} %)
                                <div class="summary-bar"><span class="summary-bar-fill" style="width: {{ summary.productionPercent }}%" aria-hidden="true"></span></div>
                            </li>
                            <li>Absence — {{ summary.absenceDuration }} ({{ summary.absencePercent }} %)
                                <div class="summary-bar"><span class="summary-bar-fill" style="width: {{ summary.absencePercent }}%" aria-hidden="true"></span></div>
                            </li>
                        </ul>
                    </section>

                    <section aria-labelledby="summary-projects">
                        <h3 id="summary-projects">Répartition par projet</h3>
                        <ul class="summary-list">
                            {% for project in summary.projects %}
                                <li>{{ project.label }} — {{ project.duration }} ({{ project.percent }} %)
                                    <div class="summary-bar"><span class="summary-bar-fill" style="width: {{ project.percent }}%" aria-hidden="true"></span></div>
                                </li>
                            {% endfor %}
                            {% if summary.othersCount > 0 %}
                                <li>Autres projets ({{ summary.othersCount }}) — {{ summary.othersDuration }} ({{ summary.othersPercent }} %)</li>
                            {% endif %}
                        </ul>
                    </section>
                {% endif %}

                <section aria-labelledby="summary-planning" class="summary-planning">
                    <h3 id="summary-planning">Planning à venir</h3>
                    <p class="hint">Le module d'affectation n'est pas encore activé — le planning s'affichera ici prochainement.</p>
                </section>
            </dialog>
        </div>

        {% if projects is empty %}
            <p>Aucun projet actif : demandez à un administrateur d'en créer un pour saisir votre temps.</p>
        {% else %}
            <table class="timesheet" data-timesheet-target="grid">
                <thead>
                    <tr>
                        <th scope="col">Projet</th>
                        {% for day in days %}
                            <th scope="col">{{ day.label }}</th>
                        {% endfor %}
                    </tr>
                </thead>
                <tbody>
                    {% for project in projects %}
                        <tr>
                            <th scope="row" title="{{ project.code }}">{{ project.name }}</th>
                            {% for day in days %}
                                {% set minutes = grid[project.id][day.date] ?? null %}
                                <td>
                                    <input
                                        type="number"
                                        min="0"
                                        max="1440"
                                        step="15"
                                        inputmode="numeric"
                                        aria-label="{{ project.name }} — {{ day.label }} (minutes)"
                                        value="{{ minutes }}"
                                        data-timesheet-target="cell"
                                        data-project-id="{{ project.id }}"
                                        data-date="{{ day.date }}"
                                        data-action="change->timesheet#save"
                                    >
                                </td>
                            {% endfor %}
                        </tr>
                    {% endfor %}
                </tbody>
            </table>

            <div class="timesheet-actions">
                <button type="button" data-action="timesheet#duplicatePreviousWeek">Dupliquer la semaine précédente</button>
                <button type="button" data-action="timesheet#saveWeek">Enregistrer la semaine</button>
                <span class="hint">Entrée = valider et descendre · Tab = cellule suivante · saisie possible sans souris.</span>
            </div>

            <p class="hint" aria-live="polite" data-timesheet-target="status">
                Saisissez les minutes par projet et par jour. L'enregistrement est automatique ; « Enregistrer la semaine » soumet tout en une fois.
            </p>
        {% endif %}
    </main>
{% endblock %}
