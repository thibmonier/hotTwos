{% extends 'base.html.twig' %}

{% block title %}Saisie du jour — {{ dayLabel }}{% endblock %}

{% block page_section %}Temps & activité{% endblock %}
{% block page_title %}Saisie du jour{% endblock %}

{% block body %}
{# data-controller="timesheet-day" asserté par TimesheetDayPageTest #}
<div data-controller="timesheet-day"
     data-timesheet-day-date-value="{{ date }}"
     data-timesheet-day-prev-value="{{ prevDate }}"
     data-timesheet-day-next-value="{{ nextDate }}">

    <h1 class="visually-hidden">Saisie du jour</h1>

    {# Navigation entre les jours #}
    <nav class="flex items-center gap-2 mb-4" aria-label="Navigation entre les jours">
        <a href="{{ path('timesheet_day', { date: prevDate }) }}"
           class="w-11 h-11 inline-flex items-center justify-center border border-border-strong rounded-md bg-surface text-body no-underline hover:bg-surface-alt hover:text-ink"
           rel="prev" aria-label="Jour précédent">←</a>
        <a href="{{ path('timesheet_day', { date: todayDate }) }}"
           class="font-semibold text-body text-sm no-underline hover:text-primary">{{ dayLabel }} — semaine {{ weekNumber }}</a>
        <a href="{{ path('timesheet_day', { date: nextDate }) }}"
           class="w-11 h-11 inline-flex items-center justify-center border border-border-strong rounded-md bg-surface text-body no-underline hover:bg-surface-alt hover:text-ink"
           rel="next" aria-label="Jour suivant">→</a>
    </nav>

    {# Total journalier (mis à jour par Stimulus) #}
    <p class="text-base font-semibold text-ink min-h-6 mb-3" data-timesheet-day-target="total" aria-live="polite"></p>

    {# Bannières hors-ligne #}
    <p class="flex items-center gap-2 rounded-md border border-border bg-surface-alt px-4 py-3 text-sm text-muted mb-3"
       role="status" aria-live="polite" hidden data-timesheet-day-target="offlineBanner">
        <span aria-hidden="true">📴</span> Pas de connexion — vos saisies sont conservées sur cet appareil.
    </p>
    <p class="flex items-center gap-2 rounded-md border border-border bg-surface-alt px-4 py-3 text-sm text-muted mb-3"
       role="status" aria-live="polite" hidden data-timesheet-day-target="resyncBanner">
        <span aria-hidden="true">🔄</span> Saisies en attente de synchronisation.
        <button type="button" class="text-sm text-primary hover:underline ml-1 p-0" data-action="timesheet-day#resync">Resynchroniser</button>
    </p>

    {% if projects is empty %}
        <div class="rounded-md border border-border bg-surface p-4 text-muted">
            Aucun projet actif : demandez à un administrateur d'en créer un pour saisir votre temps.
        </div>
    {% else %}
        <div class="mb-3">
            <button type="button"
                    class="inline-flex min-h-11 items-center rounded border border-border-strong px-3 text-xs font-semibold text-muted hover:bg-surface-alt hover:text-ink"
                    data-action="timesheet-day#duplicatePrevious">
                Reprendre la saisie de la veille
            </button>
        </div>

        <ul class="flex flex-col gap-3 p-0 m-0 list-none mb-2" aria-label="Saisie des temps par projet">
            {% for project in projects %}
                {% set minutes = minutesByProject[project.id] ?? null %}
                <li class="rounded-md border border-border bg-surface p-4">
                    <div class="font-semibold text-ink mb-2">
                        {{ project.name }} <small class="font-normal text-muted text-xs ml-2">{{ project.code }}</small>
                    </div>

                    <div class="mb-2">
                        <label class="block text-xs font-medium text-body mb-1" for="duration-{{ loop.index }}">Durée (minutes)</label>
                        <input type="number" id="duration-{{ loop.index }}"
                               class="w-[100px] min-h-11 text-center text-base border border-border-strong rounded-md bg-surface text-body px-2"
                               inputmode="numeric" min="0" max="1440" step="15"
                               value="{{ minutes }}"
                               data-timesheet-day-target="entry"
                               data-project-id="{{ project.id }}"
                               data-previous-minutes="{{ previousMinutesByProject[project.id] ?? '' }}"
                               data-action="input->timesheet-day#recalculate"
                               aria-describedby="duration-help">
                    </div>

                    <div>
                        <label class="block text-xs font-medium text-body mb-1" for="comment-{{ loop.index }}">Commentaire (optionnel)</label>
                        <input type="text" id="comment-{{ loop.index }}"
                               class="w-full min-h-11 text-base border border-border-strong rounded-md bg-surface text-body px-3"
                               maxlength="500"
                               data-timesheet-day-target="comment"
                               data-project-id="{{ project.id }}">
                    </div>
                </li>
            {% endfor %}
        </ul>

        <p id="duration-help" class="text-xs text-muted mb-3">Durée en minutes, par pas de 15 (ex. 90 pour 1h30).</p>

        {# "Enregistrer la journée" asserté par TimesheetDayPageTest #}
        <div class="flex items-center gap-3 flex-wrap mt-4">
            <button type="button"
                    class="inline-flex min-h-11 items-center rounded bg-primary px-4 text-sm font-semibold text-white hover:opacity-90"
                    data-timesheet-day-target="submit"
                    data-action="timesheet-day#submitDay">
                Enregistrer la journée
            </button>
            <span class="text-xs text-muted" role="status" aria-live="polite" data-timesheet-day-target="status"></span>
        </div>
    {% endif %}

    <div class="mt-4">
        <a href="{{ path('timesheet_week', { date: date }) }}" class="text-sm text-primary hover:underline">← Vue semaine (bureau)</a>
    </div>

</div>
{% endblock %}
