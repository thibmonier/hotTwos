{% extends 'base.html.twig' %}

{% block title %}Régimes de travail{% endblock %}
{% block page_section %}Paramétrage{% endblock %}
{% block page_title %}Régimes de travail (temps partiel){% endblock %}

{% block body %}
    <h1 class="visually-hidden">régimes de travail</h1>

    <p class="mb-4 max-w-2xl text-sm text-muted">
        Définissez les jours travaillés d'un collaborateur à temps partiel. Sans régime, le collaborateur
        est à temps plein (lundi à vendredi). Fériés et fermetures s'appliquent en plus.
    </p>

    <form method="post" action="{{ path('work_schedule_save') }}" class="mb-6 flex flex-wrap items-end gap-4">
        <input type="hidden" name="_token" value="{{ csrf_token('work_schedule_save') }}">
        <div>
            <label for="ws-collaborator" class="mb-1 block text-[13px] font-medium text-ink">Collaborateur</label>
            <select id="ws-collaborator" name="collaborator" class="min-h-10 rounded border border-border-strong bg-surface px-3 text-sm text-ink">
                {% for id, name in collaborators %}<option value="{{ id }}">{{ name }}</option>{% endfor %}
            </select>
        </div>
        <fieldset class="flex flex-wrap items-center gap-3">
            <legend class="mb-1 block text-[13px] font-medium text-ink">Jours travaillés</legend>
            {% for value, label in weekdays %}
                <label class="flex items-center gap-1 text-sm text-body">
                    <input type="checkbox" name="weekdays[]" value="{{ value }}"> {{ label }}
                </label>
            {% endfor %}
        </fieldset>
        <button type="submit" class="min-h-10 rounded bg-primary px-4 text-sm font-semibold text-white hover:bg-primary/90">Enregistrer</button>
    </form>

    <div class="overflow-x-auto">
        <table class="w-full border-collapse text-sm">
            <caption class="sr-only">Régimes de travail par collaborateur</caption>
            <thead>
                <tr class="border-b-2 border-border text-left text-xs uppercase text-muted">
                    <th scope="col" class="py-2 pr-4">Collaborateur</th>
                    <th scope="col" class="py-2 pr-4">Jours travaillés</th>
                    <th scope="col" class="py-2 text-right">Action</th>
                </tr>
            </thead>
            <tbody>
                {% for id, name in collaborators %}
                    <tr class="border-b border-border">
                        <th scope="row" class="py-2 pr-4 font-medium text-ink">{{ name }}</th>
                        <td class="py-2 pr-4">
                            {% if schedulesByUser[id] is defined %}
                                {% for d in schedulesByUser[id] %}{{ weekdays[d] }}{% if not loop.last %}, {% endif %}{% endfor %}
                            {% else %}<span class="text-muted">Temps plein (Lun-Ven)</span>{% endif %}
                        </td>
                        <td class="py-2 text-right">
                            {% if schedulesByUser[id] is defined %}
                                <form method="post" action="{{ path('work_schedule_delete', { userId: id }) }}" class="inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('work_schedule_delete') }}">
                                    <button type="submit" class="text-xs font-medium text-danger hover:underline">Retirer</button>
                                </form>
                            {% else %}<span class="text-muted">—</span>{% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="3" class="py-4 text-center text-muted">Aucun collaborateur.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
