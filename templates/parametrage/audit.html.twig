{% extends 'base.html.twig' %}

{% block title %}Journal d'audit{% endblock %}
{% block page_section %}Paramétrage{% endblock %}
{% block page_title %}Journal d'audit du paramétrage{% endblock %}

{% block body %}
    <h1 class="visually-hidden">journal d'audit du paramétrage</h1>

    <p class="mb-4 max-w-2xl text-sm text-muted">
        Historique immuable des modifications de paramétrage (qui, quoi, avant/après, quand).
    </p>

    <form method="get" action="{{ path('audit_log_index') }}" class="mb-6 flex flex-wrap items-end gap-3">
        <div>
            <label for="filter-objectType" class="mb-1 block text-[13px] font-medium text-ink">Type d'objet</label>
            <input id="filter-objectType" name="objectType" type="text" value="{{ objectType }}"
                   class="min-h-10 w-64 rounded border border-border-strong bg-surface px-3 text-sm text-ink">
        </div>
        <button type="submit" class="min-h-10 rounded bg-primary px-4 text-sm font-semibold text-white hover:bg-primary/90">Filtrer</button>
        <a href="{{ path('audit_log_index') }}" class="min-h-10 inline-flex items-center rounded border border-border-strong px-4 text-sm text-muted hover:text-ink">Réinitialiser</a>
    </form>

    <div class="overflow-x-auto">
        <table class="w-full border-collapse text-sm">
            <caption class="sr-only">Journal d'audit du paramétrage</caption>
            <thead>
                <tr class="border-b-2 border-border text-left text-xs uppercase text-muted">
                    <th scope="col" class="py-2 pr-4">Date</th>
                    <th scope="col" class="py-2 pr-4">Auteur</th>
                    <th scope="col" class="py-2 pr-4">Action</th>
                    <th scope="col" class="py-2 pr-4">Objet</th>
                    <th scope="col" class="py-2">Détail</th>
                </tr>
            </thead>
            <tbody>
                {% for e in entries %}
                    <tr class="border-b border-border">
                        <th scope="row" class="py-2 pr-4 whitespace-nowrap font-medium text-ink">{{ e.at }}</th>
                        <td class="py-2 pr-4">{{ e.actor }}</td>
                        <td class="py-2 pr-4">{{ e.action }}</td>
                        <td class="py-2 pr-4">{{ e.objectType }} — {{ e.objectLabel }}</td>
                        <td class="py-2 text-muted">
                            {% if e.field %}{{ e.field }} : {{ e.before ?? '∅' }} → {{ e.after ?? '∅' }}{% else %}—{% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="5" class="py-4 text-center text-muted">Aucune entrée d'audit.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
