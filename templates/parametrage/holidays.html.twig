{% extends 'base.html.twig' %}

{% block title %}Jours fériés{% endblock %}
{% block page_section %}Paramétrage{% endblock %}
{% block page_title %}Jours fériés du tenant{% endblock %}

{% block body %}
    <h1 class="visually-hidden">jours fériés du tenant</h1>

    <p class="mb-4 max-w-2xl text-sm text-muted">
        Les jours fériés déclarés ici sont exclus des jours ouvrés partout (capacité, occupation,
        complétude, relances). Ils s'appliquent à l'ensemble du tenant.
    </p>

    <form method="post" action="{{ path('holiday_add') }}" class="mb-6 flex flex-wrap items-end gap-3">
        <input type="hidden" name="_token" value="{{ csrf_token('holiday_add') }}">
        <div>
            <label for="holiday-date" class="mb-1 block text-[13px] font-medium text-ink">Date</label>
            <input id="holiday-date" name="date" type="date" required
                   class="min-h-10 rounded border border-border-strong bg-surface px-3 text-sm text-ink">
        </div>
        <div>
            <label for="holiday-label" class="mb-1 block text-[13px] font-medium text-ink">Libellé</label>
            <input id="holiday-label" name="label" type="text" required maxlength="255" placeholder="Fête nationale"
                   class="min-h-10 w-64 rounded border border-border-strong bg-surface px-3 text-sm text-ink">
        </div>
        <button type="submit" class="min-h-10 rounded bg-primary px-4 text-sm font-semibold text-white hover:bg-primary/90">Ajouter</button>
    </form>

    <div class="overflow-x-auto">
        <table class="w-full border-collapse text-sm">
            <caption class="sr-only">Liste des jours fériés du tenant</caption>
            <thead>
                <tr class="border-b-2 border-border text-left text-xs uppercase text-muted">
                    <th scope="col" class="py-2 pr-4">Date</th>
                    <th scope="col" class="py-2 pr-4">Libellé</th>
                    <th scope="col" class="py-2 text-right">Action</th>
                </tr>
            </thead>
            <tbody>
                {% for holiday in holidays %}
                    <tr class="border-b border-border">
                        <th scope="row" class="py-2 pr-4 font-medium text-ink">{{ holiday.date|date('d/m/Y') }}</th>
                        <td class="py-2 pr-4">{{ holiday.label }}</td>
                        <td class="py-2 text-right">
                            <form method="post" action="{{ path('holiday_delete', { id: holiday.id }) }}" class="inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('holiday_delete') }}">
                                <button type="submit" class="text-xs font-medium text-danger hover:underline">Supprimer</button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="3" class="py-4 text-center text-muted">Aucun jour férié déclaré.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
