{% extends 'base.html.twig' %}

{% block title %}Clients{% endblock %}
{% block page_section %}Référentiel{% endblock %}
{% block page_title %}Comptes clients{% endblock %}

{% block body %}
<div data-controller="clients">
    <h1 class="sr-only">comptes clients</h1>

    <twig:tsf:Layout:PageHeader
        title="Comptes clients"
        subtitle="Référentiel des clients du cabinet" />

    {# ── Recherche (G3) — filtrage nom/SIREN sans rechargement ──────────────── #}
    {% if clients is not empty %}
        <div class="mb-3">
            <label for="cli-search" class="sr-only">Rechercher un client</label>
            <input type="search" id="cli-search" data-clients-target="search" data-action="input->clients#filter"
                   placeholder="Rechercher (nom ou SIREN)…"
                   class="min-h-9 w-full max-w-sm rounded-lg border border-gray-300 bg-white px-3 text-theme-sm text-gray-700 placeholder:text-gray-400 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/40 dark:border-gray-700 dark:bg-white/[0.03] dark:text-gray-300">
        </div>
    {% endif %}

    {# ── Liste des clients ──────────────────────────────────────────────────── #}
    <div class="mb-6 overflow-x-auto rounded-2xl border border-gray-200 bg-white shadow-theme-sm dark:border-gray-800 dark:bg-white/[0.03]">
        <table class="w-full border-collapse text-left text-theme-sm">
            <caption class="sr-only">Liste des comptes clients du cabinet</caption>
            <thead>
                <tr class="border-b border-gray-100 bg-gray-50 dark:border-gray-800 dark:bg-white/[0.02]">
                    <th scope="col" class="px-4 py-3 font-semibold text-gray-700 dark:text-gray-300">Client</th>
                    <th scope="col" class="px-4 py-3 font-semibold text-gray-700 dark:text-gray-300">SIREN</th>
                </tr>
            </thead>
            <tbody>
                {% for c in clients %}
                    <tr class="border-t border-gray-100 hover:bg-gray-50 dark:border-gray-800 dark:hover:bg-white/[0.02]"
                        data-clients-target="row"
                        data-search="{{ (c.name ~ ' ' ~ (c.siren ?? ''))|lower }}">
                        <th scope="row" class="px-4 py-3 font-medium text-gray-800 dark:text-white/90">{{ c.name }}</th>
                        <td class="px-4 py-3 tabular-nums text-gray-500 dark:text-gray-400">{{ c.siren ?? '—' }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="2" class="px-4 py-6 text-center text-gray-500 dark:text-gray-400">Aucun client.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {# ── Nouveau client ─────────────────────────────────────────────────────── #}
    <h2 class="mb-3 text-theme-sm font-semibold text-gray-800 dark:text-white/90">Nouveau client</h2>
    <form method="post" action="{{ path('client_create') }}" class="flex max-w-xl flex-wrap items-end gap-3">
        <input type="hidden" name="_token" value="{{ csrf_token('create_client') }}">
        <div class="grow">
            <label for="client-name" class="mb-1 block text-theme-xs font-medium text-gray-700 dark:text-gray-300">Nom</label>
            <input id="client-name" name="name" required
                   class="min-h-10 w-full rounded-lg border border-gray-300 bg-white px-3 text-theme-sm text-gray-700 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/40 dark:border-gray-700 dark:bg-white/[0.03] dark:text-gray-300">
        </div>
        <div>
            <label for="client-siren" class="mb-1 block text-theme-xs font-medium text-gray-700 dark:text-gray-300">SIREN (optionnel)</label>
            <input id="client-siren" name="siren" inputmode="numeric"
                   class="min-h-10 rounded-lg border border-gray-300 bg-white px-3 text-theme-sm text-gray-700 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/40 dark:border-gray-700 dark:bg-white/[0.03] dark:text-gray-300">
        </div>
        <twig:tsf:Ui:Button type="submit" variant="primary">Créer</twig:tsf:Ui:Button>
    </form>
</div>
{% endblock %}
