{% extends 'base.html.twig' %}

{% block title %}Clients{% endblock %}
{% block page_section %}Référentiel{% endblock %}
{% block page_title %}Comptes clients{% endblock %}

{% block body %}
    <h1 class="visually-hidden">comptes clients</h1>

    <div class="mb-6 overflow-x-auto">
        <table class="w-full border-collapse text-sm">
            <thead>
                <tr class="border-b-2 border-border text-left text-xs uppercase text-muted">
                    <th scope="col" class="py-2 pr-4">Client</th>
                    <th scope="col" class="py-2">SIREN</th>
                </tr>
            </thead>
            <tbody>
                {% for c in clients %}
                    <tr class="border-b border-border">
                        <th scope="row" class="py-2 pr-4 font-medium text-ink">{{ c.name }}</th>
                        <td class="py-2 text-muted">{{ c.siren ?? '—' }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="2" class="py-4 text-center text-muted">Aucun client.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <h2 class="mb-2 text-sm font-semibold text-ink">Nouveau client</h2>
    <form method="post" action="{{ path('client_create') }}" class="flex max-w-xl flex-wrap items-end gap-3">
        <input type="hidden" name="_token" value="{{ csrf_token('create_client') }}">
        <div class="grow">
            <label for="client-name" class="mb-1 block text-[13px] font-medium text-ink">Nom</label>
            <input id="client-name" name="name" required class="min-h-10 w-full rounded border border-border-strong bg-surface px-3 text-sm text-ink">
        </div>
        <div>
            <label for="client-siren" class="mb-1 block text-[13px] font-medium text-ink">SIREN (optionnel)</label>
            <input id="client-siren" name="siren" inputmode="numeric" class="min-h-10 rounded border border-border-strong bg-surface px-3 text-sm text-ink">
        </div>
        <button type="submit" class="min-h-10 rounded bg-primary px-4 text-sm font-semibold text-white hover:bg-primary/90">Créer</button>
    </form>
{% endblock %}
