{% extends 'base.html.twig' %}

{% block title %}Mes absences{% endblock %}

{% block body %}
    <main class="container" data-controller="absence">
        <h1>Mes absences</h1>

        <section aria-labelledby="counters-heading" class="absence-counters">
            <h2 id="counters-heading">Mes compteurs</h2>
            <dl>
                <dt>Acquis</dt><dd>{{ counters.acquired }} j</dd>
                <dt>Pris</dt><dd>{{ counters.taken }} j</dd>
                <dt>En attente</dt><dd>{{ counters.pending }} j</dd>
                <dt>Solde</dt><dd>{{ counters.balance }} j</dd>
                <dt>Solde projeté <span class="hint" title="Si toutes les demandes en attente sont approuvées">ℹ️</span></dt>
                <dd>{{ counters.projected }} j</dd>
            </dl>
        </section>

        <section aria-labelledby="declare-heading">
            <h2 id="declare-heading">Déclarer une absence</h2>
            <form data-action="submit->absence#declare">
                <label>Type
                    <select required data-absence-target="type">
                        {% for type in types %}
                            <option value="{{ type.id }}">{{ type.label }}</option>
                        {% endfor %}
                    </select>
                </label>
                <label>Du <input type="date" required data-absence-target="startDate"></label>
                <label>Au <input type="date" required data-absence-target="endDate"></label>
                <label><input type="checkbox" checked data-absence-target="startsMorning"> Commence le matin</label>
                <label><input type="checkbox" checked data-absence-target="endsAfternoon"> Finit l'après-midi</label>
                <label>Commentaire (optionnel) <input type="text" data-absence-target="comment" placeholder="ex. Vacances d'été"></label>
                <button type="submit">Soumettre la demande</button>
            </form>
            <p class="hint" aria-live="polite" data-absence-target="status"></p>
        </section>

        <section aria-labelledby="list-heading">
            <h2 id="list-heading">Mes demandes</h2>
            {% if requests is empty %}
                <p>Aucune demande d'absence pour l'instant.</p>
            {% else %}
                <table class="absence-list">
                    <thead>
                        <tr>
                            <th scope="col">Du</th>
                            <th scope="col">Au</th>
                            <th scope="col">Statut</th>
                            <th scope="col">Motif de refus</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for r in requests %}
                            <tr>
                                <td>{{ r.from }}</td>
                                <td>{{ r.to }}</td>
                                <td>
                                    {% if r.status == 'validated' %}<span aria-hidden="true">✅</span> Validée
                                    {% elseif r.status == 'rejected' %}<span aria-hidden="true">❌</span> Refusée
                                    {% else %}<span aria-hidden="true">⏳</span> En attente{% endif %}
                                </td>
                                <td>{{ r.reason ?? '—' }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        </section>
    </main>
{% endblock %}
