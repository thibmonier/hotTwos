{% extends 'base.html.twig' %}

{% block title %}Mes absences{% endblock %}
{% block page_section %}Absences{% endblock %}
{% block page_title %}Mes absences{% endblock %}

{% block body %}
<div data-controller="absence">
    <h1 class="sr-only">Mes absences</h1>

    {# ── Compteurs ───────────────────────────────────────────────── #}
    <section aria-labelledby="counters-heading" class="mb-5">
        <h2 id="counters-heading" class="mb-3 text-theme-sm font-semibold text-gray-800 dark:text-white/90">Mes compteurs</h2>
        <div class="grid gap-4 [grid-template-columns:repeat(auto-fill,minmax(10rem,1fr))]">
            <div class="rounded-2xl border border-gray-200 bg-white p-4 shadow-theme-sm dark:border-gray-800 dark:bg-white/[0.03]">
                <div class="text-theme-xs text-gray-500 dark:text-gray-400">Acquis</div>
                <div class="mt-1 text-title-sm font-bold text-gray-800 dark:text-white/90">{{ counters.acquired }} j</div>
            </div>
            <div class="rounded-2xl border border-gray-200 bg-white p-4 shadow-theme-sm dark:border-gray-800 dark:bg-white/[0.03]">
                <div class="text-theme-xs text-gray-500 dark:text-gray-400">Pris</div>
                <div class="mt-1 text-title-sm font-bold text-gray-800 dark:text-white/90">{{ counters.taken }} j</div>
            </div>
            <div class="rounded-2xl border border-gray-200 bg-white p-4 shadow-theme-sm dark:border-gray-800 dark:bg-white/[0.03]">
                <div class="text-theme-xs text-gray-500 dark:text-gray-400">En attente</div>
                <div class="mt-1 text-title-sm font-bold text-warning-700 dark:text-warning-400">{{ counters.pending }} j</div>
            </div>
            <div class="rounded-2xl border border-success-200 bg-success-50 p-4 shadow-theme-sm dark:border-success-500/30 dark:bg-success-500/10">
                <div class="text-theme-xs text-gray-500 dark:text-gray-400">Solde</div>
                <div class="mt-1 text-title-sm font-bold text-success-700 dark:text-success-400">{{ counters.balance }} j</div>
            </div>
            <div class="rounded-2xl border border-gray-200 bg-white p-4 shadow-theme-sm dark:border-gray-800 dark:bg-white/[0.03]">
                <div class="flex items-center gap-1 text-theme-xs text-gray-500 dark:text-gray-400">
                    Solde projeté
                    <span role="img" title="Si toutes les demandes en attente sont approuvées"
                          aria-label="Si toutes les demandes en attente sont approuvées"><span aria-hidden="true">ℹ️</span></span>
                </div>
                <div class="mt-1 text-title-sm font-bold text-gray-800 dark:text-white/90">{{ counters.projected }} j</div>
            </div>
        </div>
    </section>

    {# ── Déclarer une absence ────────────────────────────────────── #}
    <section aria-labelledby="declare-heading" class="mb-5 rounded-2xl border border-gray-200 bg-white shadow-theme-sm dark:border-gray-800 dark:bg-white/[0.03]">
        <div class="border-b border-gray-100 px-5 py-4 dark:border-gray-800">
            <h2 id="declare-heading" class="text-theme-sm font-semibold text-gray-800 dark:text-white/90">Déclarer une absence</h2>
        </div>
        <div class="p-5">
            <form data-action="submit->absence#declare" aria-labelledby="declare-heading" novalidate>
                <div class="mb-4">
                    <label for="absence-type" class="mb-1 block text-theme-sm font-medium text-gray-600 dark:text-gray-300">
                        Type <span aria-hidden="true" class="text-error-500">*</span><span class="sr-only">(obligatoire)</span>
                    </label>
                    <select id="absence-type"
                            class="block w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-theme-sm text-gray-800 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/40 dark:border-gray-700 dark:bg-white/[0.03] dark:text-white/90"
                            required aria-required="true"
                            data-absence-target="type">
                        <option value="">— Choisir un type —</option>
                        {% for type in types %}
                            <option value="{{ type.id }}">{{ type.label }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="mb-4 flex flex-wrap gap-4">
                    <div class="min-w-0 flex-1">
                        <label for="absence-start" class="mb-1 block text-theme-sm font-medium text-gray-600 dark:text-gray-300">
                            Du <span aria-hidden="true" class="text-error-500">*</span><span class="sr-only">(obligatoire)</span>
                        </label>
                        <input type="date" id="absence-start"
                               class="block w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-theme-sm text-gray-800 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/40 dark:border-gray-700 dark:bg-white/[0.03] dark:text-white/90"
                               required aria-required="true"
                               data-absence-target="startDate">
                    </div>
                    <div class="min-w-0 flex-1">
                        <label for="absence-end" class="mb-1 block text-theme-sm font-medium text-gray-600 dark:text-gray-300">
                            Au <span aria-hidden="true" class="text-error-500">*</span><span class="sr-only">(obligatoire)</span>
                        </label>
                        <input type="date" id="absence-end"
                               class="block w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-theme-sm text-gray-800 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/40 dark:border-gray-700 dark:bg-white/[0.03] dark:text-white/90"
                               required aria-required="true"
                               data-absence-target="endDate">
                    </div>
                </div>

                <div class="mb-4 flex flex-wrap gap-4">
                    <label class="inline-flex min-h-11 cursor-pointer items-center gap-2">
                        <input type="checkbox" id="absence-starts-morning"
                               class="h-4 w-4 rounded border-gray-300 accent-brand-500"
                               checked data-absence-target="startsMorning">
                        <span class="text-theme-sm text-gray-700 dark:text-gray-300">Commence le matin</span>
                    </label>
                    <label class="inline-flex min-h-11 cursor-pointer items-center gap-2">
                        <input type="checkbox" id="absence-ends-afternoon"
                               class="h-4 w-4 rounded border-gray-300 accent-brand-500"
                               checked data-absence-target="endsAfternoon">
                        <span class="text-theme-sm text-gray-700 dark:text-gray-300">Finit l'après-midi</span>
                    </label>
                </div>

                {# Solde projeté rappelé au moment de la déclaration (reco ABS-02). #}
                <div class="mb-4 flex items-center gap-2 rounded-lg border border-blue-light-200 bg-blue-light-50 px-3 py-2.5 dark:border-blue-light-500/30 dark:bg-blue-light-500/10">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="text-blue-light-500" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/></svg>
                    <span class="text-theme-sm text-blue-light-700 dark:text-blue-light-400">Solde projeté après vos demandes en attente : <strong>{{ counters.projected }} j</strong>.</span>
                </div>

                <div class="mb-5">
                    <label for="absence-comment" class="mb-1 block text-theme-sm font-medium text-gray-600 dark:text-gray-300">
                        Commentaire <span class="font-normal text-gray-400">(optionnel)</span>
                    </label>
                    <input type="text" id="absence-comment"
                           class="block w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-theme-sm text-gray-800 placeholder:text-gray-400 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/40 dark:border-gray-700 dark:bg-white/[0.03] dark:text-white/90"
                           maxlength="500" data-absence-target="comment"
                           placeholder="ex. Vacances d'été" aria-describedby="comment-warning">
                    <p id="comment-warning" class="mt-1.5 text-theme-xs text-gray-500 dark:text-gray-400">
                        <span aria-hidden="true">⚠️</span>
                        Ne renseignez <strong>aucune donnée de santé</strong> (motif médical, diagnostic) — RGPD.
                    </p>
                </div>

                <button type="submit"
                        class="inline-flex min-h-11 items-center rounded-lg bg-brand-500 px-4 py-2.5 text-theme-sm font-semibold text-white hover:bg-brand-600">
                    Soumettre la demande
                </button>
            </form>

            <p class="mt-3 text-theme-xs text-gray-500 dark:text-gray-400" aria-live="polite" data-absence-target="status"></p>
        </div>
    </section>

    {# ── Mes demandes ────────────────────────────────────────────── #}
    <section aria-labelledby="list-heading" class="rounded-2xl border border-gray-200 bg-white shadow-theme-sm dark:border-gray-800 dark:bg-white/[0.03]">
        <div class="border-b border-gray-100 px-5 py-4 dark:border-gray-800">
            <h2 id="list-heading" class="text-theme-sm font-semibold text-gray-800 dark:text-white/90">Mes demandes</h2>
        </div>
        {% if requests is empty %}
            <div class="p-5">
                <p class="text-gray-500 dark:text-gray-400">Aucune demande d'absence pour l'instant.</p>
            </div>
        {% else %}
            <div class="overflow-x-auto">
                <table class="w-full border-collapse text-left text-theme-sm" aria-labelledby="list-heading">
                    <caption class="sr-only">Liste de vos demandes d'absence</caption>
                    <thead>
                        <tr class="border-b border-gray-100 bg-gray-50 dark:border-gray-800 dark:bg-white/[0.02]">
                            <th scope="col" class="px-5 py-3 font-semibold text-gray-700 dark:text-gray-300">Du</th>
                            <th scope="col" class="px-5 py-3 font-semibold text-gray-700 dark:text-gray-300">Au</th>
                            <th scope="col" class="px-5 py-3 font-semibold text-gray-700 dark:text-gray-300">Statut</th>
                            <th scope="col" class="px-5 py-3 font-semibold text-gray-700 dark:text-gray-300">Motif de refus</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for r in requests %}
                            <tr class="border-t border-gray-100 hover:bg-gray-50 dark:border-gray-800 dark:hover:bg-white/[0.02]">
                                <td class="px-5 py-3 text-gray-800 dark:text-white/90">{{ r.from }}</td>
                                <td class="px-5 py-3 text-gray-800 dark:text-white/90">{{ r.to }}</td>
                                <td class="px-5 py-3">
                                    {% if r.status == 'validated' %}
                                        <span class="inline-flex items-center gap-1.5 rounded-full bg-success-50 px-2.5 py-1 text-theme-xs font-medium text-success-700 dark:bg-success-500/15 dark:text-success-400">
                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg> Validée
                                        </span>
                                    {% elseif r.status == 'rejected' %}
                                        <span class="inline-flex items-center gap-1.5 rounded-full bg-error-50 px-2.5 py-1 text-theme-xs font-medium text-error-700 dark:bg-error-500/15 dark:text-error-400">
                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12"/></svg> Refusée
                                        </span>
                                    {% else %}
                                        <span class="inline-flex items-center gap-1.5 rounded-full bg-warning-50 px-2.5 py-1 text-theme-xs font-medium text-warning-700 dark:bg-warning-500/15 dark:text-warning-400">
                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg> En attente
                                        </span>
                                    {% endif %}
                                </td>
                                <td class="px-5 py-3 text-gray-500 dark:text-gray-400">{{ r.reason ?? '—' }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </section>
</div>
{% endblock %}
