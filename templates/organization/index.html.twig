{% extends 'base.html.twig' %}

{% block title %}Organisation{% endblock %}

{% block page_section %}Administration{% endblock %}
{% block page_title %}Structure organisationnelle{% endblock %}

{% block body %}
    <h1 class="visually-hidden">Structure organisationnelle</h1>

    <div data-controller="organization">

        {# Unités #}
        <section aria-labelledby="units-heading" class="mb-4">
            <h2 id="units-heading" class="fs-5 fw-semibold mb-3">Unités</h2>

            {% if rows is empty %}
                <p class="text-muted" data-organization-target="empty">
                    Aucune unité pour l'instant. Créez la première ci-dessous.
                </p>
            {% else %}
                <div class="card">
                    <ul class="list-group list-group-flush">
                        {% for row in rows %}
                            <li class="list-group-item d-flex align-items-center justify-content-between gap-2"
                                style="padding-left: calc(var(--space-3) + {{ row.depth * 1.5 }}rem)">
                                <span class="{{ row.active ? 'fw-medium' : 'text-muted fst-italic' }}">
                                    {{ row.name }}{{ row.active ? '' : ' (désactivée)' }}
                                </span>
                                {% if row.active %}
                                    <button type="button"
                                            class="btn btn-outline-secondary btn-sm"
                                            data-action="organization#deactivate"
                                            data-org-id="{{ row.id }}"
                                            aria-label="Désactiver l'unité {{ row.name }}">
                                        Désactiver
                                    </button>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}
        </section>

        {# Ajouter une unité #}
        <section aria-labelledby="create-heading" class="mb-4">
            <h2 id="create-heading" class="fs-5 fw-semibold mb-3">Ajouter une unité</h2>
            <div class="card">
                <div class="card-body">
                    <form data-action="submit->organization#createUnit">
                        <div class="mb-3">
                            <label for="org-unit-name" class="form-label">Nom</label>
                            <input type="text" id="org-unit-name" class="form-control" required
                                   data-organization-target="unitName"
                                   placeholder="ex. Direction financière">
                        </div>
                        <div class="mb-3">
                            <label for="org-unit-parent" class="form-label">Rattacher sous</label>
                            <select id="org-unit-parent" class="form-select"
                                    data-organization-target="unitParent">
                                <option value="">— racine —</option>
                                {% for row in rows %}
                                    <option value="{{ row.id }}">{{ row.indent }}{{ row.name }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <button type="submit" class="btn btn-primary btn-sm">Créer l'unité</button>
                    </form>
                </div>
            </div>
        </section>

        {# Rattacher un collaborateur #}
        <section aria-labelledby="attach-heading" class="mb-4">
            <h2 id="attach-heading" class="fs-5 fw-semibold mb-3">Rattacher un collaborateur</h2>
            <div class="card">
                <div class="card-body">
                    <form data-action="submit->organization#attach">
                        <div class="mb-3">
                            <label for="org-user-id" class="form-label">Identifiant du collaborateur</label>
                            <input type="text" id="org-user-id" class="form-control" required
                                   data-organization-target="userId"
                                   placeholder="UUID du collaborateur">
                        </div>
                        <div class="mb-3">
                            <label for="org-attach-unit" class="form-label">Unité</label>
                            <select id="org-attach-unit" class="form-select" required
                                    data-organization-target="attachUnit">
                                {% for row in rows|filter(r => r.active) %}
                                    <option value="{{ row.id }}">{{ row.indent }}{{ row.name }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="org-effective-from" class="form-label">À partir du</label>
                            <input type="date" id="org-effective-from" class="form-control" required
                                   data-organization-target="effectiveFrom">
                        </div>
                        <button type="submit" class="btn btn-primary btn-sm">Rattacher</button>
                    </form>
                </div>
            </div>
        </section>

        <p class="text-muted small" aria-live="polite" data-organization-target="status"></p>
    </div>
{% endblock %}
