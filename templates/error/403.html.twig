{% extends 'base.html.twig' %}

{#
  Page 403 habillée (régression recette US-066 / ANO-1). Étend le shell HotOnes pour offrir une
  sortie (sidebar filtrée par habilitation) plutôt qu'une impasse. Aucun interne divulgué (règle 11 §7).
#}

{% block title %}Accès refusé — HotOnes{% endblock %}
{% block page_section %}Erreur{% endblock %}
{% block page_title %}Accès refusé{% endblock %}

{% block body %}
    <div class="mx-auto max-w-lg rounded-md border border-border bg-surface p-8 text-center shadow-sm">
        <div class="mx-auto mb-4 grid h-12 w-12 place-items-center rounded-lg bg-primary-surface text-white" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-6 w-6">
                <rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
        </div>
        <h1 class="text-xl font-semibold text-ink">Accès refusé</h1>
        <p class="mt-2 text-sm text-muted">{{ message|default("Vous n'avez pas l'autorisation d'accéder à cette page.") }}</p>
        <a href="{{ path('home') }}"
           class="mt-6 inline-flex min-h-11 items-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-white hover:bg-primary/90">
            Retour à l'accueil
        </a>
    </div>
{% endblock %}
