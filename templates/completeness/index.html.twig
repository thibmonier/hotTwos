{% extends 'base.html.twig' %}

{% block page_section %}Temps & activité{% endblock %}
{% block page_title %}Complétude de saisie{% endblock %}

{% set labels = {
    'submitted': 'Soumis',
    'partial': 'Partiel',
    'empty_late': 'Vide',
    'in_progress': 'En cours'
} %}

{% set badge_classes = {
    'submitted': 'status-badge-success',
    'partial': 'status-badge-warning',
    'empty_late': 'status-badge-danger',
    'in_progress': 'status-badge-neutral'
} %}

{% block body %}
    <h1 class="visually-hidden">Complétude de saisie</h1>

    <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
        <p class="m-0 text-muted">
            {{ team ? 'Périmètre équipe' : 'Vos semaines' }} — 4 dernières semaines.
        </p>
        <a href="{{ path('api_completeness_export') }}{{ team ? '?scope=team' : '' }}"
           class="inline-flex min-h-9 items-center rounded border border-border-strong px-3 text-xs font-semibold text-muted hover:bg-surface-alt hover:text-ink">
            Exporter en CSV
        </a>
    </div>

    <section aria-labelledby="legend-heading" class="mb-3">
        <h2 id="legend-heading" class="visually-hidden">Légende</h2>
        <div class="flex flex-wrap items-center gap-3 rounded-md border border-border bg-surface-alt px-4 py-2.5">
            <span class="text-xs font-semibold uppercase tracking-wider text-muted">Légende</span>
            <span class="status-badge status-badge-success">Soumis</span>
            <span class="status-badge status-badge-warning">Partiel</span>
            <span class="status-badge status-badge-danger">Vide</span>
            <span class="status-badge status-badge-neutral">En cours</span>
        </div>
    </section>

    {% if rows is empty %}
        <div class="rounded-md border border-border bg-surface p-4 text-muted">
            Aucune donnée de saisie disponible pour votre périmètre. Les premières saisies apparaîtront ici.
        </div>
    {% else %}
        <div class="overflow-x-auto rounded-md border border-border bg-surface shadow-sm">
            <table class="w-full border-collapse text-left">
                <caption class="visually-hidden">Grille de complétude de saisie par collaborateur et par semaine</caption>
                <thead>
                    <tr class="bg-surface-alt">
                        <th scope="col" class="px-4 py-3 font-semibold text-body">Collaborateur</th>
                        {% for week in weeks %}
                            {# Libellé humanisé : n° de semaine ISO + date de début courte (date ISO en title).
                               La clé `week` (Y-m-d) reste inchangée pour le lookup `cells[week]`. #}
                            <th scope="col" class="px-3 py-3 text-center font-semibold text-body" title="Semaine du {{ week|date('d/m/Y') }}">
                                Sem. {{ week|date('W') }}
                                <span class="block text-xs font-normal text-muted">{{ week|date('d/m') }}</span>
                            </th>
                        {% endfor %}
                    </tr>
                </thead>
                <tbody>
                    {% for userId, cells in rows %}
                        <tr class="border-t border-border">
                            <th scope="row" class="max-w-[180px] truncate px-4 py-3 font-normal text-ink">{{ userDisplayNames[userId]|default(userId[:8]) }}</th>
                            {% for week in weeks %}
                                {% set cell = cells[week] ?? null %}
                                <td class="px-3 py-2 text-center">
                                    {% if cell %}
                                        {% set stateLabel = labels[cell.state] ?? cell.state %}
                                        {% set stateClass = badge_classes[cell.state] ?? 'status-badge-neutral' %}
                                        <span class="status-badge {{ stateClass }}" aria-label="{{ stateLabel }} ({{ cell.rate }}%)">
                                            {{ stateLabel }}
                                            <span class="ml-0.5 text-[10px]">{{ cell.rate }}%</span>
                                        </span>
                                    {% else %}
                                        <span class="text-muted" aria-label="Aucune donnée">—</span>
                                    {% endif %}
                                </td>
                            {% endfor %}
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
{% endblock %}
