{% extends 'base.html.twig' %}

{% block page_section %}Temps & activité{% endblock %}
{% block page_title %}Complétude de saisie{% endblock %}

{% set labels = {
    'submitted': 'Soumis',
    'partial': 'Partiel',
    'empty_late': 'Vide',
    'in_progress': 'En cours'
} %}

{# US-092 (F-S5-5) : chaque état = texte + icône + couleur (jamais la couleur seule). #}
{% set badge_classes = {
    'submitted': 'bg-success-50 text-success-700 dark:bg-success-500/15 dark:text-success-400',
    'partial': 'bg-warning-50 text-warning-700 dark:bg-warning-500/15 dark:text-warning-400',
    'empty_late': 'bg-error-50 text-error-700 dark:bg-error-500/15 dark:text-error-400',
    'in_progress': 'bg-gray-100 text-gray-600 dark:bg-white/[0.06] dark:text-gray-300'
} %}

{% macro state_icon(state) %}
    {% if state == 'submitted' %}<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
    {% elseif state == 'partial' %}<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 9v4M12 17h.01"/><circle cx="12" cy="12" r="9"/></svg>
    {% elseif state == 'empty_late' %}<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12"/></svg>
    {% else %}<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>{% endif %}
{% endmacro %}

{% block body %}
{% import _self as ui %}
    <h1 class="sr-only">Complétude de saisie</h1>

    {# US-092 (reco CPL-03) : StatCards de synthèse (vue équipe) pour un diagnostic < 5 s. #}
    {% if team %}
        <div class="mb-5 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
            <twig:tsf:Ui:StatCard label="Collaborateurs suivis" value="{{ summary.total }}" variant="brand" />
            <twig:tsf:Ui:StatCard label="En retard" value="{{ summary.late }}" variant="error" />
            <twig:tsf:Ui:StatCard label="Partielles" value="{{ summary.partial }}" variant="warning" />
            <twig:tsf:Ui:StatCard label="Soumises" value="{{ summary.submitted }}" variant="success" />
        </div>
    {% endif %}

    <div class="mb-3 flex flex-wrap items-center justify-between gap-3">
        <p class="m-0 text-gray-500 dark:text-gray-400">
            {{ team ? 'Périmètre équipe' : 'Vos semaines' }} — 4 dernières semaines.
        </p>
        <div class="flex items-center gap-2">
            {% if team %}
                <a href="{{ path('reminders_page') }}"
                   class="inline-flex min-h-9 items-center gap-2 rounded-lg bg-brand-500 px-3 text-theme-xs font-semibold text-white hover:bg-brand-600">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 4h16v12H5.2L4 17.2z"/></svg>
                    Relancer les retards
                </a>
            {% endif %}
            <a href="{{ path('api_completeness_export') }}{{ team ? '?scope=team' : '' }}"
               class="inline-flex min-h-9 items-center rounded-lg border border-gray-200 px-3 text-theme-xs font-semibold text-gray-600 hover:bg-gray-50 dark:border-gray-800 dark:text-gray-300 dark:hover:bg-white/[0.02]">
                Exporter en CSV
            </a>
        </div>
    </div>

    <section aria-labelledby="legend-heading" class="mb-3">
        <h2 id="legend-heading" class="sr-only">Légende</h2>
        <div class="flex flex-wrap items-center gap-2.5 rounded-xl border border-gray-200 bg-white px-4 py-2.5 dark:border-gray-800 dark:bg-white/[0.03]">
            <span class="text-theme-xs font-semibold uppercase tracking-wider text-gray-400">Légende</span>
            {% for state, label in labels %}
                <span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-theme-xs font-medium {{ badge_classes[state] }}">{{ ui.state_icon(state) }}{{ label }}</span>
            {% endfor %}
        </div>
    </section>

    {% if rows is empty %}
        <div class="rounded-2xl border border-gray-200 bg-white p-4 text-gray-500 dark:border-gray-800 dark:bg-white/[0.03] dark:text-gray-400">
            Aucune donnée de saisie disponible pour votre périmètre. Les premières saisies apparaîtront ici.
        </div>
    {% else %}
        <div class="overflow-x-auto rounded-2xl border border-gray-200 bg-white shadow-theme-sm dark:border-gray-800 dark:bg-white/[0.03]">
            <table class="w-full border-collapse text-left">
                <caption class="sr-only">Grille de complétude de saisie par collaborateur et par semaine</caption>
                <thead>
                    <tr class="border-b border-gray-100 bg-gray-50 dark:border-gray-800 dark:bg-white/[0.02]">
                        <th scope="col" class="sticky left-0 z-10 bg-gray-50 px-4 py-3 text-theme-sm font-semibold text-gray-700 dark:bg-[#1a2231] dark:text-gray-300">Collaborateur</th>
                        {% for week in weeks %}
                            <th scope="col" class="px-3 py-3 text-center text-theme-sm font-semibold text-gray-700 dark:text-gray-300" title="Semaine du {{ week|date('d/m/Y') }}">
                                Sem. {{ week|date('W') }}
                                <span class="block text-theme-xs font-normal text-gray-400">{{ week|date('d/m') }}</span>
                            </th>
                        {% endfor %}
                    </tr>
                </thead>
                <tbody>
                    {% for userId, cells in rows %}
                        <tr class="border-t border-gray-100 dark:border-gray-800">
                            {# F-S5-4 : e-mail / nom d'affichage résolu ; jamais d'identifiant technique brut. #}
                            <th scope="row" class="sticky left-0 z-10 max-w-[220px] truncate bg-white px-4 py-3 font-normal text-gray-800 dark:bg-white/[0.03] dark:text-white/90">{{ userDisplayNames[userId]|default('Collaborateur') }}</th>
                            {% for week in weeks %}
                                {% set cell = cells[week] ?? null %}
                                <td class="px-3 py-2 text-center">
                                    {% if cell %}
                                        {% set stateLabel = labels[cell.state] ?? cell.state %}
                                        <span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-theme-xs font-medium {{ badge_classes[cell.state] ?? badge_classes['in_progress'] }}" aria-label="{{ stateLabel }} ({{ cell.rate }}%)">
                                            {{ ui.state_icon(cell.state) }}{{ stateLabel }}
                                            <span class="text-[10px]">{{ cell.rate }}%</span>
                                        </span>
                                    {% else %}
                                        <span class="text-gray-400" aria-label="Aucune donnée">—</span>
                                    {% endif %}
                                </td>
                            {% endfor %}
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
{% endblock %}
