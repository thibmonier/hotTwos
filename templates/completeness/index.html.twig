{% extends 'base.html.twig' %}

{% block page_section %}Temps & activité{% endblock %}
{% block page_title %}Complétude de saisie{% endblock %}

{% set labels = {
    'submitted': 'Soumis',
    'partial': 'Partiel',
    'empty_late': 'Vide',
    'in_progress': 'En cours'
} %}

{% set badge_classes = {
    'submitted': 'status-badge-success',
    'partial': 'status-badge-warning',
    'empty_late': 'status-badge-danger',
    'in_progress': 'status-badge-neutral'
} %}

{% block body %}
    <h1 class="visually-hidden">Complétude de saisie</h1>

    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
        <p class="mb-0 text-muted">
            {{ team ? 'Périmètre équipe' : 'Vos semaines' }} — 4 dernières semaines.
        </p>
        <a href="{{ path('api_completeness_export') }}{{ team ? '?scope=team' : '' }}"
           class="btn btn-outline-secondary btn-sm">
            Exporter en CSV
        </a>
    </div>

    <section aria-labelledby="legend-heading" class="mb-3">
        <h2 id="legend-heading" class="visually-hidden">Légende</h2>
        <div class="completeness-legend-bar d-flex align-items-center flex-wrap gap-2">
            <span class="completeness-legend-title">Légende</span>
            <span class="status-badge status-badge-success">Soumis</span>
            <span class="status-badge status-badge-warning">Partiel</span>
            <span class="status-badge status-badge-danger">Vide</span>
            <span class="status-badge status-badge-neutral">En cours</span>
        </div>
    </section>

    {% if rows is empty %}
        <div class="card">
            <div class="card-body text-muted">
                Aucune donnée de saisie disponible pour votre périmètre. Les premières saisies apparaîtront ici.
            </div>
        </div>
    {% else %}
        <div class="table-responsive">
            <table class="table table-hover table-compact">
                <caption class="visually-hidden">Grille de complétude de saisie par collaborateur et par semaine</caption>
                <thead>
                    <tr>
                        <th scope="col">Collaborateur</th>
                        {% for week in weeks %}
                            <th scope="col" class="text-center">Sem. {{ week }}</th>
                        {% endfor %}
                    </tr>
                </thead>
                <tbody>
                    {% for userId, cells in rows %}
                        <tr>
                            <th scope="row" class="completeness-user-cell">{{ userEmails[userId]|default(userId[:8]) }}</th>
                            {% for week in weeks %}
                                {% set cell = cells[week] ?? null %}
                                <td class="text-center">
                                    {% if cell %}
                                        {% set stateLabel = labels[cell.state] ?? cell.state %}
                                        {% set stateClass = badge_classes[cell.state] ?? 'status-badge-neutral' %}
                                        <span class="status-badge {{ stateClass }}"
                                              aria-label="{{ stateLabel }} ({{ cell.rate }}%)">
                                            {{ stateLabel }}
                                            <span class="completeness-rate">{{ cell.rate }}%</span>
                                        </span>
                                    {% else %}
                                        <span class="text-muted" aria-label="Aucune donnée">—</span>
                                    {% endif %}
                                </td>
                            {% endfor %}
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
{% endblock %}

{% block stylesheets %}
<style>
    .completeness-legend-bar {
        padding: 10px 16px;
        background: var(--color-surface-alt);
        border: 1px solid var(--color-border-subtle);
        border-radius: var(--radius-md);
    }

    .completeness-legend-title {
        font-size: 11px;
        font-weight: var(--font-weight-semibold);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--color-text-muted);
        margin-right: 4px;
    }

    .completeness-user-cell {
        font-weight: var(--font-weight-normal);
        color: var(--color-text);
        max-width: 180px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .completeness-rate {
        font-size: 10px;
        margin-left: 3px;
        /* US-065 : pas d'opacity (elle abaissait le contraste du % sous 4.5:1) ;
           le % hérite de la couleur -emphasis du badge (conforme AA). */
    }
</style>
{% endblock %}
