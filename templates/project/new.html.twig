{% extends 'base.html.twig' %}

{% block title %}Nouveau projet{% endblock %}

{% block page_section %}Projets{% endblock %}
{% block page_title %}Nouveau projet{% endblock %}

{% block stylesheets %}
<style>
    .project-form-card {
        max-width: 720px;
    }
    .project-radio-group {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-3);
    }
    .project-radio {
        display: flex;
        align-items: center;
        gap: var(--space-2);
        cursor: pointer;
        min-height: 44px;
        padding: var(--space-1) var(--space-2);
    }
    .project-radio input[type="radio"] {
        width: 18px;
        height: 18px;
        flex-shrink: 0;
        cursor: pointer;
    }
    .project-form-card fieldset {
        border: 1px solid var(--color-border-subtle);
        border-radius: var(--radius-sm);
        padding: var(--space-3) var(--space-4);
        margin-bottom: var(--space-4);
    }
    .project-form-card legend {
        font-size: 0.875rem;
        font-weight: var(--font-weight-semibold);
        color: var(--color-text);
        padding: 0 var(--space-2);
        float: none;
        width: auto;
    }
    .project-form-card fieldset fieldset {
        border: none;
        padding: 0;
        margin-bottom: var(--space-3);
    }
    .project-form-actions {
        display: flex;
        align-items: center;
        gap: var(--space-3);
        margin-top: var(--space-4);
    }
</style>
{% endblock %}

{% block body %}
    <h1 class="visually-hidden">Nouveau projet</h1>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="ds-alert ds-alert-{{ label == 'error' ? 'danger' : label }} flash-{{ label }}"
                 role="{{ label == 'error' ? 'alert' : 'status' }}">{{ message }}</div>
        {% endfor %}
    {% endfor %}

    <div class="card project-form-card">
        <div class="card-header d-flex align-items-center justify-content-between">
            <span class="fw-semibold">Nouveau projet</span>
            <a href="{{ path('project_index') }}" class="btn btn-link btn-sm">← Retour à la liste</a>
        </div>
        <div class="card-body">
            <p class="form-text text-muted mb-3">
                Les champs marqués <abbr title="obligatoire">*</abbr> sont obligatoires (RG-PRJ-1).
            </p>

            <form method="post" action="{{ path('project_create') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('create_project') }}">

                <fieldset>
                    <legend>Identification</legend>

                    <div class="mb-3">
                        <label for="name" class="form-label">Nom du projet <abbr title="obligatoire">*</abbr></label>
                        <input type="text" class="form-control" id="name" name="name"
                               maxlength="255" required aria-required="true">
                    </div>

                    <div class="mb-3">
                        <label for="clientName" class="form-label">Client <abbr title="obligatoire">*</abbr></label>
                        <input type="text" class="form-control" id="clientName" name="clientName"
                               maxlength="255" required aria-required="true" aria-describedby="client-help">
                        <div id="client-help" class="form-text text-muted">
                            Saisie libre — deviendra une liste avec le référentiel clients (US-014).
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="responsibleUserId" class="form-label">Responsable</label>
                        <input type="text" class="form-control" id="responsibleUserId" name="responsibleUserId"
                               aria-describedby="resp-help">
                        <div id="resp-help" class="form-text text-muted">
                            Identifiant du chef de projet responsable ; par défaut, vous-même.
                        </div>
                    </div>

                    <div class="mb-0">
                        <label for="budgetEuros" class="form-label">Budget (€) <abbr title="obligatoire">*</abbr></label>
                        <input type="number" class="form-control" id="budgetEuros" name="budgetEuros"
                               min="1" step="1" inputmode="numeric" required aria-required="true">
                    </div>
                </fieldset>

                <fieldset>
                    <legend>Contractualisation et calendrier
                        <span class="text-muted fw-normal">(le calendrier est optionnel)</span>
                    </legend>

                    <fieldset class="mb-3">
                        <legend class="form-label">Contractualisation <abbr title="obligatoire">*</abbr></legend>
                        <div class="project-radio-group">
                            {% for type in contractTypes %}
                                <label class="project-radio">
                                    <input type="radio" name="contractType" value="{{ type.value }}"{{ loop.first ? ' checked' : '' }}>
                                    {{ type.label }}
                                </label>
                            {% endfor %}
                        </div>
                    </fieldset>

                    <div class="row g-3 mb-0">
                        <div class="col-md-6">
                            <label for="startDate" class="form-label">Date de début</label>
                            <input type="date" class="form-control" id="startDate" name="startDate">
                        </div>
                        <div class="col-md-6">
                            <label for="endDate" class="form-label">Date de fin</label>
                            <input type="date" class="form-control" id="endDate" name="endDate">
                        </div>
                    </div>
                </fieldset>

                <p class="form-text text-muted mb-3">
                    Statut initial : <strong>En préparation</strong>.
                </p>

                <div class="project-form-actions">
                    <button type="submit" class="btn btn-primary">Créer le projet</button>
                    <a href="{{ path('project_index') }}" class="btn btn-link">Annuler</a>
                </div>
            </form>
        </div>
    </div>
{% endblock %}
