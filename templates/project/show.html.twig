{% extends 'base.html.twig' %}

{% block title %}{{ project.code }} — {{ project.name }}{% endblock %}

{% block body %}
    <main class="container">
        <p><a href="{{ path('project_index') }}">← Projets</a></p>
        <h1>{{ project.code }} — {{ project.name }}
            <span class="project-status-badge project-status-{{ project.statusFamily }}">{{ project.status }}</span>
        </h1>
        <p class="hint">
            Client : {{ project.client ?? '—' }} · Contractualisation : {{ project.contractType ?? '—' }}
            · Budget : {{ project.budgetEuros is not null ? (project.budgetEuros|number_format(0, ',', ' ') ~ ' €') : '—' }}
            {% if project.startDate %} · Du {{ project.startDate }}{% if project.endDate %} au {{ project.endDate }}{% endif %}{% endif %}
        </p>

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <p class="flash flash-{{ label }}" role="{{ label == 'error' ? 'alert' : 'status' }}">{{ message }}</p>
            {% endfor %}
        {% endfor %}

        <div data-controller="tabs">
            <div class="project-tabs" role="tablist" aria-label="Sections du projet">
                <button class="project-tab" role="tab" id="tab-lifecycle" aria-controls="panel-lifecycle" aria-selected="true" data-tabs-target="tab" data-action="tabs#select keydown->tabs#keydown">Cycle de vie</button>
                <button class="project-tab" role="tab" id="tab-structure" aria-controls="panel-structure" aria-selected="false" tabindex="-1" data-tabs-target="tab" data-action="tabs#select keydown->tabs#keydown">Structure</button>
                <button class="project-tab" role="tab" id="tab-team" aria-controls="panel-team" aria-selected="false" tabindex="-1" data-tabs-target="tab" data-action="tabs#select keydown->tabs#keydown">Équipe</button>
                <button class="project-tab" role="tab" id="tab-commitments" aria-controls="panel-commitments" aria-selected="false" tabindex="-1" data-tabs-target="tab" data-action="tabs#select keydown->tabs#keydown">Engagements</button>
                <button class="project-tab" role="tab" id="tab-closure" aria-controls="panel-closure" aria-selected="false" tabindex="-1" data-tabs-target="tab" data-action="tabs#select keydown->tabs#keydown">Clôture</button>
            </div>

            <section class="project-tabpanel" id="panel-lifecycle" role="tabpanel" aria-labelledby="tab-lifecycle" data-tabs-target="panel">
                <h2>Cycle de vie</h2>
                <p>Statut actuel : <strong>{{ project.status }}</strong>.</p>
                {% if canEdit and transitions is not empty %}
                    <p>Actions disponibles :</p>
                    <div class="project-transitions">
                        {% for t in transitions %}
                            <form method="post" action="{{ path('project_change_status', { id: project.id }) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('change_project_status') }}">
                                <input type="hidden" name="status" value="{{ t.value }}">
                                <button type="submit">Passer à « {{ t.label }} »</button>
                            </form>
                        {% endfor %}
                    </div>
                {% elseif transitions is empty %}
                    <p class="hint">Aucune transition disponible depuis ce statut.</p>
                {% endif %}
            </section>

            <section class="project-tabpanel" id="panel-structure" role="tabpanel" aria-labelledby="tab-structure" data-tabs-target="panel" hidden>
                <h2>Structure — lots</h2>
                {% if structure.roots is empty %}
                    <p>Aucun lot défini.</p>
                {% else %}
                    <ul class="project-lot-tree">
                        {% for lot in structure.roots %}
                            <li class="project-lot-item">
                                <span class="project-lot-name">{{ lot.name }}</span> — {{ lot.days }} j / {{ lot.euros|number_format(0, ',', ' ') }} €
                                {% if lot.children is not empty %}
                                    <ul class="project-milestone-list">
                                        {% for child in lot.children %}
                                            <li>{{ child.name }} — {{ child.days }} j / {{ child.euros|number_format(0, ',', ' ') }} €</li>
                                        {% endfor %}
                                    </ul>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                    <p>Total lots : {{ structure.sumDays }} j / {{ structure.sumEuros|number_format(0, ',', ' ') }} €
                        {% if structure.budgetEuros is not null %} — Budget projet : {{ structure.budgetEuros|number_format(0, ',', ' ') }} €{% endif %}
                    </p>
                    {% if structure.gapEuros is not null and structure.gapEuros != 0 %}
                        <p class="project-budget-gap">Écart lots/budget : {{ structure.gapEuros > 0 ? '+' : '' }}{{ structure.gapEuros|number_format(0, ',', ' ') }} €</p>
                    {% endif %}
                {% endif %}

                {% if canEdit %}
                    <h3>Ajouter un lot</h3>
                    <form method="post" action="{{ path('project_lot_add', { id: project.id }) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('project_structure') }}">
                        <label for="lot-name">Nom du lot</label>
                        <input type="text" id="lot-name" name="name" required>
                        <label for="lot-days">Charge (jours)</label>
                        <input type="number" id="lot-days" name="budgetDays" min="0" inputmode="numeric" required>
                        <label for="lot-euros">Montant (€)</label>
                        <input type="number" id="lot-euros" name="budgetEuros" min="0" inputmode="numeric" required>
                        <label for="lot-parent">Lot parent (optionnel — pour un sous-lot)</label>
                        <select id="lot-parent" name="parentLotId">
                            <option value="">— Lot racine —</option>
                            {% for lot in structure.roots %}<option value="{{ lot.id }}">{{ lot.name }}</option>{% endfor %}
                        </select>
                        <label><input type="checkbox" name="confirmOverrun" value="1"> Confirmer un éventuel dépassement du budget projet</label>
                        <button type="submit">Ajouter le lot</button>
                    </form>
                {% endif %}

                <h2>Jalons</h2>
                {% if milestones is empty %}
                    <p>Aucun jalon défini.</p>
                {% else %}
                    <ul class="project-lot-tree">
                        {% for m in milestones %}
                            <li class="project-lot-item">
                                <strong>{{ m.name }}</strong> — {{ m.due }} — {{ m.status }}{% if m.reached %} (atteint le {{ m.reached }}){% endif %}
                                {% if m.billing is not null %} — <span aria-hidden="true">💰</span> facturation {{ m.billing|number_format(0, ',', ' ') }} €{% endif %}
                                {% if canEdit and not m.triggered and m.status != 'Atteint' %}
                                    <form method="post" action="{{ path('project_milestone_reach', { id: project.id, milestoneId: m.id }) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('project_structure') }}">
                                        <button type="submit">Marquer atteint</button>
                                    </form>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}

                {% if canEdit %}
                    <h3>Ajouter un jalon</h3>
                    <form method="post" action="{{ path('project_milestone_add', { id: project.id }) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('project_structure') }}">
                        <label for="ms-name">Nom du jalon</label>
                        <input type="text" id="ms-name" name="name" required>
                        <label for="ms-due">Date prévisionnelle</label>
                        <input type="date" id="ms-due" name="dueDate" required>
                        <label for="ms-billing">Déclencheur de facturation (€, optionnel)</label>
                        <input type="number" id="ms-billing" name="billingEuros" min="0" inputmode="numeric">
                        <button type="submit">Ajouter le jalon</button>
                    </form>
                {% endif %}
            </section>
            <section class="project-tabpanel" id="panel-team" role="tabpanel" aria-labelledby="tab-team" data-tabs-target="panel" hidden>
                <h2>Équipe — affectations</h2>
                {% if assignments is empty %}
                    <p>Aucune affectation. Tant qu'aucun collaborateur n'est affecté, le projet reste ouvert à la saisie ; dès la première affectation, seuls les affectés peuvent imputer.</p>
                {% else %}
                    <table class="project-list">
                        <caption class="visually-hidden">Collaborateurs affectés au projet</caption>
                        <thead><tr><th scope="col">Collaborateur</th><th scope="col">Rôle</th><th scope="col">Charge (j)</th><th scope="col">Période</th>{% if canEdit %}<th scope="col">Action</th>{% endif %}</tr></thead>
                        <tbody>
                            {% for a in assignments %}
                                <tr>
                                    <td><code>{{ a.userId[:8] }}</code></td>
                                    <td>{{ a.role }}</td>
                                    <td>{{ a.plannedDays }}</td>
                                    <td>{{ a.start ?? '—' }}{% if a.end %} → {{ a.end }}{% endif %}</td>
                                    {% if canEdit %}
                                        <td>
                                            <form method="post" action="{{ path('project_assignment_remove', { id: project.id, assignmentId: a.id }) }}">
                                                <input type="hidden" name="_token" value="{{ csrf_token('project_team') }}">
                                                <button type="submit">Retirer</button>
                                            </form>
                                        </td>
                                    {% endif %}
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% endif %}

                {% if canEdit %}
                    <h3>Affecter un collaborateur</h3>
                    <form method="post" action="{{ path('project_assignment_add', { id: project.id }) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('project_team') }}">
                        <label for="a-user">Collaborateur (identifiant)</label>
                        <input type="text" id="a-user" name="userId" required>
                        <label for="a-role">Rôle</label>
                        <input type="text" id="a-role" name="role" required>
                        <label for="a-days">Charge prévisionnelle (jours)</label>
                        <input type="number" id="a-days" name="plannedDays" min="0" inputmode="numeric" required>
                        <label for="a-start">Début (optionnel)</label>
                        <input type="date" id="a-start" name="startDate">
                        <label for="a-end">Fin (optionnel)</label>
                        <input type="date" id="a-end" name="endDate">
                        <button type="submit">Affecter</button>
                    </form>
                {% endif %}

                <h2>Ouvertures exceptionnelles</h2>
                {% if openings is empty %}
                    <p class="hint">Aucune ouverture exceptionnelle.</p>
                {% else %}
                    <ul class="project-lot-tree">
                        {% for o in openings %}
                            <li class="project-lot-item"><code>{{ o.userId[:8] }}</code> — semaine du {{ o.week }} — {{ o.reason }} <span class="hint">(accordée par {{ o.grantedBy[:8] }})</span></li>
                        {% endfor %}
                    </ul>
                {% endif %}
                {% if canEdit %}
                    <h3>Accorder une ouverture exceptionnelle</h3>
                    <form method="post" action="{{ path('project_opening_grant', { id: project.id }) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('project_team') }}">
                        <label for="o-user">Collaborateur (identifiant)</label>
                        <input type="text" id="o-user" name="userId" required>
                        <label for="o-week">Semaine (un jour de la semaine)</label>
                        <input type="date" id="o-week" name="weekStart" required>
                        <label for="o-reason">Motif</label>
                        <input type="text" id="o-reason" name="reason" maxlength="500" required>
                        <button type="submit">Accorder</button>
                    </form>
                {% endif %}
            </section>
            <section class="project-tabpanel" id="panel-commitments" role="tabpanel" aria-labelledby="tab-commitments" data-tabs-target="panel" hidden>
                <h2>Engagements externes</h2>
                <p class="hint">Sera disponible avec US-034.</p>
            </section>
            <section class="project-tabpanel" id="panel-closure" role="tabpanel" aria-labelledby="tab-closure" data-tabs-target="panel" hidden>
                <h2>Clôture</h2>
                <p class="hint">Sera disponible avec US-038.</p>
            </section>
        </div>
    </main>
{% endblock %}
