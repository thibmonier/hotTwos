{% extends 'base.html.twig' %}

{% block title %}Projets{% endblock %}

{% block page_section %}Projets{% endblock %}
{% block page_title %}Projets{% endblock %}

{% block topbar_actions %}
    {% if canCreate %}
        <twig:tsf:Ui:Button href="{{ path('project_new') }}" variant="primary" size="sm">+ Nouveau projet</twig:tsf:Ui:Button>
    {% endif %}
{% endblock %}

{% block body %}
<div data-controller="projects">
    <h1 class="sr-only">Projets</h1>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            {% if label == 'error' %}
                <div class="mb-3 rounded-lg border border-error-200 bg-error-50 px-4 py-3 text-theme-sm text-error-700 dark:border-error-500/30 dark:bg-error-500/10 dark:text-error-400" role="alert">{{ message }}</div>
            {% else %}
                <div class="mb-3 rounded-lg border border-success-200 bg-success-50 px-4 py-3 text-theme-sm text-success-700 dark:border-success-500/30 dark:bg-success-500/10 dark:text-success-400" role="status">{{ message }}</div>
            {% endif %}
        {% endfor %}
    {% endfor %}

    {# US-092 (F-S5-5) : chaque statut = texte + couleur (jamais la couleur seule). #}
    {% set status_badge_map = {
        'active':    'bg-success-50 text-success-700 dark:bg-success-500/15 dark:text-success-400',
        'cancelled': 'bg-error-50 text-error-700 dark:bg-error-500/15 dark:text-error-400',
        'closed':    'bg-gray-100 text-gray-600 dark:bg-white/[0.06] dark:text-gray-300'
    } %}

    {% if projects is empty %}
        <div class="rounded-2xl border border-dashed border-gray-300 bg-white p-8 text-center text-gray-500 shadow-theme-sm dark:border-gray-700 dark:bg-white/[0.03] dark:text-gray-400">
            <p class="mb-1">Aucun projet pour le moment.</p>
            {% if canCreate %}
                <a href="{{ path('project_new') }}"
                   class="mt-2 inline-flex min-h-9 items-center rounded-lg border border-gray-300 px-3 text-theme-xs font-semibold text-gray-600 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-brand-500/40 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-white/[0.02]">
                    Créer le premier projet
                </a>
            {% endif %}
        </div>
    {% else %}
        {# US-097 (CPL-05) : filtre statut + recherche (client, sans rechargement). #}
        <div class="mb-3 flex flex-wrap items-center gap-2">
            <label for="prj-status" class="sr-only">Filtrer par statut</label>
            <select id="prj-status" data-projects-target="status" data-action="projects#filter"
                    class="min-h-9 rounded-lg border border-gray-300 bg-white px-3 text-theme-sm text-gray-700 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/40 dark:border-gray-700 dark:bg-white/[0.03] dark:text-gray-300">
                <option value="">Tous les statuts</option>
                <option value="active">Actifs</option>
                <option value="cancelled">Annulés</option>
                <option value="closed">Clôturés</option>
            </select>
            <label for="prj-search" class="sr-only">Rechercher un projet</label>
            <input type="search" id="prj-search" data-projects-target="search" data-action="input->projects#filter"
                   placeholder="Rechercher (code ou nom)…"
                   class="min-h-9 flex-1 rounded-lg border border-gray-300 bg-white px-3 text-theme-sm text-gray-700 placeholder:text-gray-400 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/40 dark:border-gray-700 dark:bg-white/[0.03] dark:text-gray-300">
        </div>

        <div class="overflow-x-auto rounded-2xl border border-gray-200 bg-white shadow-theme-sm dark:border-gray-800 dark:bg-white/[0.03]">
            <table class="w-full border-collapse text-left text-theme-sm">
                <caption class="sr-only">Liste des projets du cabinet</caption>
                <thead>
                    <tr class="border-b border-gray-100 bg-gray-50 dark:border-gray-800 dark:bg-white/[0.02]">
                        <th scope="col" class="px-4 py-3 font-semibold text-gray-700 dark:text-gray-300">Code</th>
                        <th scope="col" class="px-4 py-3 font-semibold text-gray-700 dark:text-gray-300">Nom</th>
                        <th scope="col" class="px-4 py-3 font-semibold text-gray-700 dark:text-gray-300">Client</th>
                        <th scope="col" class="px-4 py-3 font-semibold text-gray-700 dark:text-gray-300">Statut</th>
                        <th scope="col" class="px-4 py-3 text-right font-semibold text-gray-700 dark:text-gray-300">Budget</th>
                    </tr>
                </thead>
                <tbody>
                    {% for p in projects %}
                        <tr class="border-t border-gray-100 hover:bg-gray-50 dark:border-gray-800 dark:hover:bg-white/[0.02]"
                            data-projects-target="row"
                            data-search="{{ (p.code ~ ' ' ~ p.name)|lower }}"
                            data-status="{{ p.statusFamily }}">
                            <th scope="row" class="px-4 py-3 font-normal">
                                <code class="font-mono text-theme-xs text-brand-500 dark:text-brand-400">{{ p.code }}</code>
                            </th>
                            <td class="px-4 py-3">
                                <a href="{{ path('project_show', { id: p.id }) }}"
                                   class="font-semibold text-brand-500 hover:underline dark:text-brand-400">{{ p.name }}</a>
                                {% if p.internal %}<span class="ml-1 inline-flex items-center rounded-full bg-gray-100 px-2 py-0.5 text-theme-xs font-medium text-gray-600 dark:bg-white/[0.06] dark:text-gray-300">Interne</span>{% endif %}
                            </td>
                            <td class="px-4 py-3 text-gray-800 dark:text-white/90">{{ p.client ?? '—' }}</td>
                            <td class="px-4 py-3">
                                <span class="inline-flex items-center rounded-full px-2.5 py-1 text-theme-xs font-medium {{ status_badge_map[p.statusFamily] ?? status_badge_map['closed'] }}">
                                    {{ p.status }}
                                </span>
                            </td>
                            <td class="px-4 py-3 text-right text-gray-800 dark:text-white/90">
                                {{ p.budgetEuros is not null ? (p.budgetEuros|number_format(0, ',', ' ') ~ ' €') : '—' }}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>
{% endblock %}
