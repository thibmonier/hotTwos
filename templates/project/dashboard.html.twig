{% extends 'base.html.twig' %}

{% block title %}Tableau de bord projets{% endblock %}
{% block page_section %}Projets{% endblock %}
{% block page_title %}Tableau de bord projets{% endblock %}

{% block body %}
    <h1 class="sr-only">Tableau de bord des projets</h1>

    <twig:tsf:Layout:PageHeader title="Tableau de bord projets" subtitle="Pilotage de la dérive sur vos projets">
        <twig:block name="actions">
            <a href="{{ path('project_index') }}"
               class="inline-flex min-h-11 items-center gap-2 rounded-lg border border-gray-200 px-4 text-theme-sm font-semibold text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-brand-500/40 dark:border-gray-800 dark:text-gray-300 dark:hover:bg-white/[0.02]">
                Liste des projets
            </a>
        </twig:block>
    </twig:tsf:Layout:PageHeader>

    {# ── KPI (G1) ────────────────────────────────────────────────────────────── #}
    <div class="mb-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
        <twig:tsf:Ui:StatCard label="Projets suivis" value="{{ counters.total }}" variant="brand" />
        <twig:tsf:Ui:StatCard label="En dérive" value="{{ counters.drifting }}" variant="error" />
        <twig:tsf:Ui:StatCard label="En escalade N+1" value="{{ counters.escalated }}" variant="warning" />
        <twig:tsf:Ui:StatCard label="Sans budget défini" value="{{ counters.noBudget }}" variant="warning" />
    </div>

    {# ── Projets en dérive ─────────────────────────────────────────────────────── #}
    <section aria-labelledby="alerts-heading" class="rounded-2xl border border-gray-200 bg-white shadow-theme-sm dark:border-gray-800 dark:bg-white/[0.03]">
        <div class="border-b border-gray-100 px-5 py-4 dark:border-gray-800">
            <h2 id="alerts-heading" class="text-theme-sm font-semibold text-gray-800 dark:text-white/90">Projets en alerte de dérive</h2>
        </div>
        {% if alerts is empty %}
            <div class="flex items-center gap-2 px-5 py-8">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0 text-success-500"><path d="M20 6 9 17l-5-5"/></svg>
                <span class="text-theme-sm text-gray-700 dark:text-gray-300">Aucun projet en dérive sur votre périmètre.</span>
            </div>
        {% else %}
            <div class="overflow-x-auto">
                <table class="w-full border-collapse text-left text-theme-sm">
                    <caption class="sr-only">Projets en alerte de dérive (charge ou marge)</caption>
                    <thead>
                        <tr class="border-b border-gray-100 bg-gray-50 dark:border-gray-800 dark:bg-white/[0.02]">
                            <th scope="col" class="px-4 py-3 font-semibold text-gray-700 dark:text-gray-300">Projet</th>
                            <th scope="col" class="px-4 py-3 font-semibold text-gray-700 dark:text-gray-300">Type de dérive</th>
                            <th scope="col" class="px-4 py-3 text-right font-semibold text-gray-700 dark:text-gray-300">Dépassement</th>
                            <th scope="col" class="px-4 py-3 text-right font-semibold text-gray-700 dark:text-gray-300">Consommation</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for a in alerts %}
                            <tr class="border-t border-gray-100 hover:bg-gray-50 dark:border-gray-800 dark:hover:bg-white/[0.02]">
                                <th scope="row" class="px-4 py-3 font-normal">
                                    <a href="{{ path('project_show', { id: a.id }) }}" class="font-semibold text-brand-500 hover:underline dark:text-brand-400">{{ a.name }}</a>
                                </th>
                                <td class="px-4 py-3">
                                    <span class="flex flex-wrap gap-1.5">
                                        {% if a.escalated %}<span class="inline-flex items-center rounded-full bg-error-50 px-2.5 py-1 text-theme-xs font-medium text-error-700 dark:bg-error-500/15 dark:text-error-400">Escalade N+1</span>{% endif %}
                                        {% if a.chargeDrift %}<span class="inline-flex items-center rounded-full bg-warning-50 px-2.5 py-1 text-theme-xs font-medium text-warning-700 dark:bg-warning-500/15 dark:text-warning-400">Charge</span>{% endif %}
                                        {% if a.marginDrift %}<span class="inline-flex items-center rounded-full bg-warning-50 px-2.5 py-1 text-theme-xs font-medium text-warning-700 dark:bg-warning-500/15 dark:text-warning-400">Marge</span>{% endif %}
                                    </span>
                                </td>
                                <td class="px-4 py-3 text-right tabular-nums text-gray-800 dark:text-white/90">{{ a.overrunPercent is not null ? (a.overrunPercent|number_format(0, ',', ' ') ~ ' %') : '—' }}</td>
                                <td class="px-4 py-3 text-right tabular-nums text-gray-800 dark:text-white/90">{{ a.consumptionPercent is not null ? (a.consumptionPercent|number_format(0, ',', ' ') ~ ' %') : '—' }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </section>
{% endblock %}
