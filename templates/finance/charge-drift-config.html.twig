{% extends 'base.html.twig' %}

{% block title %}Seuil de dérive de charge{% endblock %}
{% block page_section %}Finance &amp; rentabilité{% endblock %}
{% block page_title %}Seuil de dérive de charge par type de projet{% endblock %}

{% block body %}
    <h1 class="sr-only">seuil de dérive de charge par type de projet</h1>

    <twig:tsf:Layout:PageHeader
        title="Seuil de dérive de charge par type de projet"
        subtitle="Seuils d'alerte et d'escalade direction du dépassement projeté du budget de charge (OBJ-2)" />

    <p class="mb-4 max-w-2xl text-theme-sm text-gray-500 dark:text-gray-400">
        Seuil de dépassement projeté du budget de charge (atterrissage, US-036/OBJ-2) au-delà duquel un
        projet est signalé, réglable <strong>par type de projet</strong>. Un 2e seuil (escalade) déclenche
        une alerte à la direction. À défaut, les valeurs de référence sont
        {{ defaultAlert|number_format(0, ',', ' ') }}&nbsp;% (alerte) et
        {{ defaultEscalation|number_format(0, ',', ' ') }}&nbsp;% (escalade).
    </p>

    <form method="post" action="{{ path('charge_drift_config_save') }}" class="max-w-2xl">
        <input type="hidden" name="_token" value="{{ csrf_token('charge_drift_config') }}">
        <div class="overflow-x-auto rounded-2xl border border-gray-200 bg-white shadow-theme-sm dark:border-gray-800 dark:bg-white/[0.03]">
            <table class="w-full border-collapse text-left text-theme-sm">
                <thead>
                    <tr class="border-b border-gray-100 bg-gray-50 text-theme-xs uppercase dark:border-gray-800 dark:bg-white/[0.02]">
                        <th scope="col" class="px-4 py-3 font-semibold text-gray-700 dark:text-gray-300">Type de projet</th>
                        <th scope="col" class="px-4 py-3 font-semibold text-gray-700 dark:text-gray-300">Seuil d'alerte (%)</th>
                        <th scope="col" class="px-4 py-3 font-semibold text-gray-700 dark:text-gray-300">Seuil d'escalade direction (%)</th>
                    </tr>
                </thead>
                <tbody>
                    {% for type in contractTypes %}
                        {% set current = configured[type.value] ?? null %}
                        <tr class="border-t border-gray-100 dark:border-gray-800">
                            <th scope="row" class="px-4 py-3 font-medium text-gray-800 dark:text-white/90">{{ type.label }}</th>
                            <td class="px-4 py-3">
                                <label for="alert-{{ type.value }}" class="sr-only">Seuil d'alerte {{ type.label }}</label>
                                <input id="alert-{{ type.value }}" name="alert_{{ type.value }}" type="number" step="0.1" min="0" max="100" required
                                       value="{{ current ? current.alertPercent : defaultAlert }}"
                                       class="min-h-10 w-32 rounded-lg border border-gray-300 bg-white px-3 text-theme-sm text-gray-700 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/40 dark:border-gray-700 dark:bg-white/[0.03] dark:text-gray-300">
                            </td>
                            <td class="px-4 py-3">
                                <label for="escalation-{{ type.value }}" class="sr-only">Seuil d'escalade {{ type.label }}</label>
                                <input id="escalation-{{ type.value }}" name="escalation_{{ type.value }}" type="number" step="0.1" min="0" max="100" required
                                       value="{{ current ? current.escalationPercent : defaultEscalation }}"
                                       class="min-h-10 w-32 rounded-lg border border-gray-300 bg-white px-3 text-theme-sm text-gray-700 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/40 dark:border-gray-700 dark:bg-white/[0.03] dark:text-gray-300">
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        <div class="mt-4 flex gap-2">
            <twig:tsf:Ui:Button type="submit" variant="primary">Enregistrer</twig:tsf:Ui:Button>
            <twig:tsf:Ui:Button href="{{ path('finance_dashboard') }}" variant="secondary">Retour</twig:tsf:Ui:Button>
        </div>
    </form>
{% endblock %}
