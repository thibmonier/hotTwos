{% extends 'base.html.twig' %}

{% block title %}Seuil de dérive{% endblock %}
{% block page_section %}Finance &amp; rentabilité{% endblock %}
{% block page_title %}Seuil d'alerte de dérive de marge{% endblock %}

{% block body %}
    <h1 class="sr-only">seuil de dérive de marge</h1>

    <twig:tsf:Layout:PageHeader
        title="Seuil d'alerte de dérive de marge"
        subtitle="Réglage du seuil au-delà duquel un projet est signalé « en dérive » (OBJ-6)" />

    <p class="mb-4 max-w-xl text-theme-sm text-gray-500 dark:text-gray-400">
        Seuil (en points de taux de marge) au-delà duquel un projet est signalé « en dérive »
        (suivi budgétaire US-072, dashboard finance US-073). À défaut, la valeur de référence est
        {{ default }} points (OBJ-6).
    </p>

    <div class="max-w-sm rounded-2xl border border-gray-200 bg-white p-4 shadow-theme-sm dark:border-gray-800 dark:bg-white/[0.03]">
        <form method="post" action="{{ path('margin_drift_config_save') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('margin_drift_config') }}">
            <label for="points" class="mb-1 block text-theme-xs font-medium text-gray-700 dark:text-gray-300">Seuil (points, 0–100)</label>
            <input id="points" name="points" type="number" min="0" max="100" required
                   value="{{ threshold ? threshold.points : default }}"
                   class="min-h-10 w-full rounded-lg border border-gray-300 bg-white px-3 text-theme-sm text-gray-700 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/40 dark:border-gray-700 dark:bg-white/[0.03] dark:text-gray-300">
            <div class="mt-4 flex gap-2">
                <twig:tsf:Ui:Button type="submit" variant="primary">Enregistrer</twig:tsf:Ui:Button>
                <twig:tsf:Ui:Button href="{{ path('finance_dashboard') }}" variant="secondary">Retour</twig:tsf:Ui:Button>
            </div>
        </form>
    </div>
{% endblock %}
