{% extends 'base.html.twig' %}

{% block title %}Tableau de bord finance consolidé{% endblock %}

{% block page_section %}Finance &amp; rentabilité{% endblock %}
{% block page_title %}Tableau de bord finance consolidé{% endblock %}

{% block body %}
    {% set d = dashboard %}
    {# H1 lecteur d'écran, attendu par les tests (sous-chaîne "tableau de bord finance consolidé"). #}
    <h1 class="sr-only">tableau de bord finance consolidé</h1>

    <twig:tsf:Layout:PageHeader
        title="Tableau de bord finance consolidé"
        subtitle="Marges consolidées des périodes clôturées" />

    {# ── Sélecteur de période ─────────────────────────────────────────────── #}
    <form method="get" class="mb-6 flex flex-wrap items-end gap-3">
        <div>
            <label for="period" class="mb-1 block text-theme-xs font-medium text-gray-500 dark:text-gray-400">Période (mois clôturé)</label>
            <select id="period" name="period" onchange="this.form.submit()"
                    class="min-h-10 rounded-lg border border-gray-300 bg-white px-3 text-theme-sm text-gray-700 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/40 dark:border-gray-700 dark:bg-white/[0.03] dark:text-gray-300">
                {% if d.availablePeriods is empty %}
                    <option>—</option>
                {% endif %}
                {% for p in d.availablePeriods %}
                    <option value="{{ p }}" {{ p == d.period ? 'selected' : '' }}>{{ p }}</option>
                {% endfor %}
            </select>
        </div>
        {% if d.clientFilter is not null %}
            <a href="{{ path('finance_dashboard', { period: d.period }) }}"
               class="inline-flex min-h-10 items-center rounded-lg border border-gray-300 px-3 text-theme-sm text-gray-500 hover:text-gray-800 focus:outline-none focus:ring-2 focus:ring-brand-500/40 dark:border-gray-700 dark:text-gray-400 dark:hover:text-white/90">
                Client&nbsp;: <strong class="mx-1 text-gray-800 dark:text-white/90">{{ d.clientFilter }}</strong> — tous les clients ✕
            </a>
        {% endif %}
        <span class="inline-flex min-h-10 items-center rounded-lg bg-gray-50 px-3 text-theme-xs text-gray-500 dark:bg-white/[0.02] dark:text-gray-400">Données figées (période clôturée)</span>
        {% if d.hasData and d.costVisible %}
            <twig:tsf:Ui:Button href="{{ path('finance_export_fec', { period: d.period }) }}" variant="primary" size="sm">
                Export FEC
            </twig:tsf:Ui:Button>
        {% endif %}
    </form>

    {% if not d.hasData %}
        <p class="rounded-2xl border border-gray-200 bg-white px-4 py-6 text-center text-theme-sm text-gray-500 shadow-theme-sm dark:border-gray-800 dark:bg-white/[0.03] dark:text-gray-400">
            Aucune marge figée pour cette période. Le tableau de bord consolide les marges des périodes
            <strong>clôturées</strong> ; une période ouverte n'apparaît pas ici (provisoire).
        </p>
    {% else %}
        {# ── KPI (G1 — tsf:Ui:StatCard) ───────────────────────────────────── #}
        <h2 class="mb-3 text-theme-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">Indicateurs consolidés</h2>
        <div class="mb-6 grid grid-cols-1 gap-4 sm:grid-cols-4">
            <twig:tsf:Ui:StatCard
                label="Revenu retenu"
                value="{{ (d.totalRevenueCents / 100)|number_format(2, ',', ' ') }} €"
                variant="brand" />
            {% if d.costVisible %}
                <twig:tsf:Ui:StatCard
                    label="Coût valorisé"
                    value="{{ (d.totalCostCents / 100)|number_format(2, ',', ' ') }} €" />
                <twig:tsf:Ui:StatCard
                    label="Marge"
                    value="{{ (d.totalMarginCents / 100)|number_format(2, ',', ' ') }} €"
                    variant="{{ d.totalMarginCents >= 0 ? 'success' : 'error' }}"
                    :delta="d.totalMarginRatePercent is not null ? (d.totalMarginRatePercent|number_format(1, ',', ' ') ~ ' %') : null"
                    :trend="d.totalMarginCents >= 0 ? 'up' : 'down'" />
                <twig:tsf:Ui:StatCard
                    label="Projets en dérive"
                    value="{{ d.driftingProjectCount }} / {{ d.projectCount }}"
                    variant="{{ d.driftingProjectCount > 0 ? 'error' : 'brand' }}" />
            {% else %}
                <div class="sm:col-span-3">
                    <twig:tsf:Ui:StatCard
                        label="Projets consolidés"
                        value="{{ d.projectCount }}"
                        hint="Coût, marge et dérive réservés aux rôles habilités (finance/direction)." />
                </div>
            {% endif %}
        </div>

        {% if d.hasPartial %}
            <p class="mb-4 text-theme-sm text-warning-600 dark:text-warning-400" role="status">⚠ Certaines marges sont partielles (valorisation incomplète).</p>
        {% endif %}

        {# ── Ventilation par client ───────────────────────────────────────── #}
        <h2 class="mb-3 text-theme-sm font-semibold text-gray-800 dark:text-white/90">Ventilation par client</h2>
        <div class="mb-6 overflow-x-auto rounded-2xl border border-gray-200 bg-white shadow-theme-sm dark:border-gray-800 dark:bg-white/[0.03]">
            <table class="w-full border-collapse text-left text-theme-sm">
                <thead>
                    <tr class="border-b border-gray-100 bg-gray-50 text-theme-xs uppercase dark:border-gray-800 dark:bg-white/[0.02]">
                        <th scope="col" class="px-4 py-3 font-semibold text-gray-700 dark:text-gray-300">Client</th>
                        <th scope="col" class="px-4 py-3 text-right font-semibold text-gray-700 dark:text-gray-300">Projets</th>
                        <th scope="col" class="px-4 py-3 text-right font-semibold text-gray-700 dark:text-gray-300">Revenu retenu</th>
                        {% if d.costVisible %}
                            <th scope="col" class="px-4 py-3 text-right font-semibold text-gray-700 dark:text-gray-300">Coût chargé</th>
                            <th scope="col" class="px-4 py-3 text-right font-semibold text-gray-700 dark:text-gray-300">Marge</th>
                        {% endif %}
                    </tr>
                </thead>
                <tbody>
                    {% for c in d.byClient %}
                        <tr class="border-t border-gray-100 hover:bg-gray-50 dark:border-gray-800 dark:hover:bg-white/[0.02]">
                            <th scope="row" class="px-4 py-3 font-medium text-gray-800 dark:text-white/90">
                                <a class="font-semibold text-brand-500 hover:underline dark:text-brand-400" href="{{ path('finance_dashboard', { period: d.period, client: c.clientName }) }}">{{ c.clientName }}</a>
                            </th>
                            <td class="px-4 py-3 text-right tabular-nums text-gray-600 dark:text-gray-300">{{ c.projectCount }}</td>
                            <td class="px-4 py-3 text-right tabular-nums text-gray-800 dark:text-white/90">{{ (c.revenueCents / 100)|number_format(2, ',', ' ') }} €</td>
                            {% if d.costVisible %}
                                <td class="px-4 py-3 text-right tabular-nums text-gray-600 dark:text-gray-300">{{ (c.costCents / 100)|number_format(2, ',', ' ') }} €</td>
                                <td class="px-4 py-3 text-right tabular-nums font-medium {{ c.marginCents >= 0 ? 'text-success-600 dark:text-success-500' : 'text-error-600 dark:text-error-500' }}">
                                    {{ (c.marginCents / 100)|number_format(2, ',', ' ') }} €
                                    {% if c.marginRatePercent is not null %}<span class="font-normal text-gray-500 dark:text-gray-400">({{ c.marginRatePercent|number_format(1, ',', ' ') }} %)</span>{% endif %}
                                </td>
                            {% endif %}
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {# ── Ventilation par projet ───────────────────────────────────────── #}
        <h2 class="mb-3 text-theme-sm font-semibold text-gray-800 dark:text-white/90">Ventilation par projet</h2>
        <div class="overflow-x-auto rounded-2xl border border-gray-200 bg-white shadow-theme-sm dark:border-gray-800 dark:bg-white/[0.03]">
            <table class="w-full border-collapse text-left text-theme-sm">
                <thead>
                    <tr class="border-b border-gray-100 bg-gray-50 text-theme-xs uppercase dark:border-gray-800 dark:bg-white/[0.02]">
                        <th scope="col" class="px-4 py-3 font-semibold text-gray-700 dark:text-gray-300">Projet</th>
                        <th scope="col" class="px-4 py-3 font-semibold text-gray-700 dark:text-gray-300">Client</th>
                        <th scope="col" class="px-4 py-3 text-right font-semibold text-gray-700 dark:text-gray-300">Revenu retenu</th>
                        {% if d.costVisible %}
                            <th scope="col" class="px-4 py-3 text-right font-semibold text-gray-700 dark:text-gray-300">Coût chargé</th>
                            <th scope="col" class="px-4 py-3 text-right font-semibold text-gray-700 dark:text-gray-300">Marge</th>
                        {% endif %}
                    </tr>
                </thead>
                <tbody>
                    {% for p in d.byProject %}
                        <tr class="border-t border-gray-100 hover:bg-gray-50 dark:border-gray-800 dark:hover:bg-white/[0.02]">
                            <th scope="row" class="px-4 py-3 font-medium text-gray-800 dark:text-white/90">
                                {{ p.projectName }}
                                {% if p.partial %}<span class="ml-1 inline-flex items-center rounded-full bg-warning-50 px-2 py-0.5 text-theme-xs font-medium text-warning-700 dark:bg-warning-500/15 dark:text-warning-400">partielle</span>{% endif %}
                            </th>
                            <td class="px-4 py-3 text-gray-500 dark:text-gray-400">{{ p.clientName }}</td>
                            <td class="px-4 py-3 text-right tabular-nums text-gray-800 dark:text-white/90">{{ (p.revenueCents / 100)|number_format(2, ',', ' ') }} €</td>
                            {% if d.costVisible %}
                                <td class="px-4 py-3 text-right tabular-nums text-gray-600 dark:text-gray-300">{{ (p.costCents / 100)|number_format(2, ',', ' ') }} €</td>
                                <td class="px-4 py-3 text-right tabular-nums font-medium {{ p.marginCents >= 0 ? 'text-success-600 dark:text-success-500' : 'text-error-600 dark:text-error-500' }}">
                                    {{ (p.marginCents / 100)|number_format(2, ',', ' ') }} €
                                    {% if p.marginRatePercent is not null %}<span class="font-normal text-gray-500 dark:text-gray-400">({{ p.marginRatePercent|number_format(1, ',', ' ') }} %)</span>{% endif %}
                                </td>
                            {% endif %}
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
{% endblock %}
