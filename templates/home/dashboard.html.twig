{% extends 'base.html.twig' %}

{% block title %}Tableau de bord{% endblock %}
{% block page_section %}Accueil{% endblock %}
{% block page_title %}Tableau de bord{% endblock %}

{% macro hours(minutes) %}{{ (minutes / 60)|number_format(1, ',', ' ') }}{% endmacro %}

{% block body %}
{% import _self as fmt %}

<twig:tsf:Layout:PageHeader title="Bonjour, {{ userEmail }}" subtitle="{{ todayLabel }} · Semaine {{ weekNumber }}">
    <twig:block name="actions">
        <a href="{{ path('timesheet_week') }}"
           class="inline-flex min-h-11 items-center gap-2 rounded-lg bg-brand-500 px-4 text-theme-sm font-semibold text-white hover:bg-brand-600">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
            Saisir mes temps
        </a>
    </twig:block>
</twig:tsf:Layout:PageHeader>

{# ── Contrepartie visible : 4 StatCards (G1) ─────────────────────────────── #}
<div class="mb-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">

    <twig:tsf:Ui:StatCard
        label="Heures cette semaine"
        value="{{ fmt.hours(weekMinutes) }} h"
        variant="brand"
        :progress="weekPercent"
        hint="Objectif : {{ fmt.hours(weekTargetMinutes) }} h">
        <twig:block name="icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
        </twig:block>
    </twig:tsf:Ui:StatCard>

    <twig:tsf:Ui:StatCard
        label="Ma complétude (4 sem.)"
        value="{{ completenessPercent }} %"
        variant="warning"
        :progress="completenessPercent">
        <twig:block name="icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 19V5M10 19V9M16 19v-6M22 19H2"/></svg>
        </twig:block>
    </twig:tsf:Ui:StatCard>

    <twig:tsf:Ui:StatCard
        label="Solde de congés"
        value="{{ leaveBalance }} j"
        variant="success"
        hint="Projeté après demandes en attente : {{ leaveProjected }} j"
        href="{{ path('absence_page') }}">
        <twig:block name="icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18M8 2v4M16 2v4"/></svg>
        </twig:block>
    </twig:tsf:Ui:StatCard>

    <twig:tsf:Ui:StatCard
        label="Mes projets récents"
        value="{{ activeProjectsCount }}"
        variant="brand">
        <twig:block name="icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18"/></svg>
        </twig:block>
    </twig:tsf:Ui:StatCard>

</div>

<div class="grid gap-6 lg:grid-cols-3">

    {# ── Mes imputations récentes ─────────────────────────────────────────── #}
    <section class="lg:col-span-2 rounded-2xl border border-gray-200 bg-white shadow-theme-sm dark:border-gray-800 dark:bg-white/[0.03]">
        <div class="flex items-center justify-between border-b border-gray-100 px-5 py-4 dark:border-gray-800">
            <h2 class="text-theme-sm font-semibold text-gray-800 dark:text-white/90">Mes imputations récentes</h2>
            <a href="{{ path('timesheet_week') }}" class="text-theme-sm font-semibold text-brand-500 hover:underline">Tout voir</a>
        </div>
        {% if recent is empty %}
            <div class="px-5 py-8 text-center">
                <p class="mb-3 text-gray-500 dark:text-gray-400">Aucune imputation récente.</p>
                <a href="{{ path('timesheet_week') }}" class="inline-flex min-h-11 items-center rounded-lg bg-brand-500 px-4 text-theme-sm font-semibold text-white hover:bg-brand-600">Saisir mes temps</a>
            </div>
        {% else %}
            <ul class="m-0 list-none p-0">
                {% for r in recent %}
                    <li class="flex items-center justify-between border-b border-gray-100 px-5 py-3.5 last:border-b-0 dark:border-gray-800">
                        <div>
                            <div class="font-medium text-gray-800 dark:text-white/90">{{ r.project }}</div>
                            <div class="text-theme-xs text-gray-400">{{ r.code }} · {{ r.date }}</div>
                        </div>
                        <span class="font-semibold text-gray-800 tabular-nums dark:text-white/90">{{ fmt.hours(r.minutes) }} h</span>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </section>

    {# ── Actions rapides ──────────────────────────────────────────────────── #}
    <section class="rounded-2xl border border-gray-200 bg-white shadow-theme-sm dark:border-gray-800 dark:bg-white/[0.03]">
        <div class="border-b border-gray-100 px-5 py-4 dark:border-gray-800">
            <h2 class="text-theme-sm font-semibold text-gray-800 dark:text-white/90">Actions rapides</h2>
        </div>
        <div class="flex flex-col gap-3 p-5">
            <a href="{{ path('timesheet_day_today') }}" class="flex min-h-11 items-center gap-3 rounded-lg border border-gray-200 px-4 font-medium text-gray-700 hover:bg-gray-50 dark:border-gray-800 dark:text-gray-300 dark:hover:bg-white/[0.02]">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18"/></svg>
                Saisie du jour (mobile)
            </a>
            <a href="{{ path('absence_page') }}" class="flex min-h-11 items-center gap-3 rounded-lg border border-gray-200 px-4 font-medium text-gray-700 hover:bg-gray-50 dark:border-gray-800 dark:text-gray-300 dark:hover:bg-white/[0.02]">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M8 2v4M16 2v4M3 10h18"/><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M9 16l2 2 4-4"/></svg>
                Poser une absence
            </a>
        </div>
    </section>

</div>
{% endblock %}
