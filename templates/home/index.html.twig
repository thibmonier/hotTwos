{% extends 'base.html.twig' %}

{% block title %}{{ appName }} — Accueil{% endblock %}

{% block page_section %}Tableau de bord{% endblock %}
{% block page_title %}{{ appName }}{% endblock %}

{% block body %}
    <h1 class="visually-hidden">{{ appName }}</h1>

    {# US-019 (EF-REF-29) — checklist de mise en route, tant qu'elle n'est pas complète #}
    {% if onboarding is not null %}
        <section class="mb-6 rounded-md border border-primary/30 bg-primary/5 p-4 shadow-sm" aria-labelledby="onboarding-title">
            <h2 id="onboarding-title" class="mb-1 font-semibold text-ink">Mise en route</h2>
            <p class="mb-3 text-sm text-muted">Quelques étapes pour rendre votre espace opérationnel.</p>
            <ul class="flex flex-col gap-2 text-sm">
                <li class="flex items-center gap-2">
                    <span aria-hidden="true">{{ onboarding.profileReady ? '✅' : '⬜' }}</span>
                    <span class="{{ onboarding.profileReady ? 'text-muted line-through' : 'text-ink' }}">Vérifier le profil par défaut</span>
                </li>
                <li class="flex items-center gap-2">
                    <span aria-hidden="true">{{ onboarding.projectCreated ? '✅' : '⬜' }}</span>
                    <a href="{{ path('project_index') }}" class="{{ onboarding.projectCreated ? 'text-muted line-through' : 'text-primary hover:underline' }}">Créer un premier projet</a>
                </li>
                <li class="flex items-center gap-2">
                    <span aria-hidden="true">{{ onboarding.timeSubmitted ? '✅' : '⬜' }}</span>
                    <a href="{{ path('timesheet_week') }}" class="{{ onboarding.timeSubmitted ? 'text-muted line-through' : 'text-primary hover:underline' }}">Saisir un premier temps</a>
                </li>
            </ul>
        </section>
    {% endif %}

    <div class="rounded-md border border-border bg-surface shadow-sm">
        <div class="border-b border-border px-4 py-3 font-semibold text-ink">Socle applicatif</div>
        <div class="p-4">
            <p class="mb-3 text-muted">
                Rendu serveur opérationnel — Twig + Turbo + Stimulus.
            </p>
            <ul class="flex flex-col gap-2">
                <li class="flex items-center gap-2">
                    <span class="text-muted">Santé API (DTO) :</span>
                    <a href="/api/status" class="text-primary hover:underline">/api/status</a>
                </li>
                <li class="flex items-center gap-2">
                    <span class="text-muted">Santé applicative :</span>
                    <a href="/health" class="text-primary hover:underline">/health</a>
                </li>
            </ul>
        </div>
    </div>
{% endblock %}
