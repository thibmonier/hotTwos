{% extends 'base.html.twig' %}

{% block title %}{{ appName }} — Accueil{% endblock %}

{% block page_section %}Tableau de bord{% endblock %}
{% block page_title %}{{ appName }}{% endblock %}

{% block body %}
    <h1 class="visually-hidden">{{ appName }}</h1>

    <div class="card">
        <div class="card-header fw-semibold">Socle applicatif</div>
        <div class="card-body">
            <p class="text-muted mb-3">
                Rendu serveur opérationnel — Twig + Turbo + Stimulus.
            </p>
            <ul class="list-unstyled mb-0 d-flex flex-column gap-2">
                <li class="d-flex align-items-center gap-2">
                    <span class="text-muted">Santé API (DTO) :</span>
                    <a href="/api/status" class="btn btn-link btn-sm p-0">/api/status</a>
                </li>
                <li class="d-flex align-items-center gap-2">
                    <span class="text-muted">Santé applicative :</span>
                    <a href="/health" class="btn btn-link btn-sm p-0">/health</a>
                </li>
            </ul>
        </div>
    </div>
{% endblock %}
